import {urls} from "../../../data";
<main class="page-grid-guide">
  <h1>Page Grid Guide</h1>

  <p>
    Welcome to the Page Grid Guide page where you can find various responsive
    templates built using Skin's page grid.
  </p>
  <p>
    Please bear in mind that these are just examples that may contain
    experimental features. When implementing page grid in your own application,
    make sure to double-check support and functionality and test accordingly.
  </p>

  <div class="template--tiles">
    <div class="template--item">
      <div class="template--item_head">
        <h2>Blog with Sub-Grid</h2>
        <div class="template--item_head_actions">
          <a
            href=`${urls.guideExamples}/page-grid-blog-stretchy-subgrid`
            target="_blank">
            Open
          </a>
        </div>
      </div>
      <iframe
        src=`${urls.guideExamples}/page-grid-blog-stretchy-subgrid`
        frameborder="0"/>
    </div>

    <div class="template--item">
      <div class="template--item_head">
        <h2>Pricing</h2>
        <div class="template--item_head_actions">
          <a href=`${urls.guideExamples}/page-grid-pricing` target="_blank">
            Open
          </a>
        </div>
      </div>
      <iframe src=`${urls.guideExamples}/page-grid-pricing` frameborder="0"/>
    </div>
  </div>
</main>

<style>
  iframe {
    border: 1px solid #000;
    width: 320px;
    height: 480px;
    min-height: 480px;
    resize: both;
    overflow: auto;
  }

  .template--item {
    display: inline-block;
    margin-right: 20px;
  }

  .template--item_head {
    display: flex;
    align-items: baseline;
  }
  .template--item_head_actions {
    margin-left: auto;
  }
</style>
