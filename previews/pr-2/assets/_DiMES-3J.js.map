  <h3 id="calendar-readonly-range">
    Read-Only Calendar with Date Range
  </h3>
  <p>
    Date ranges are conveyed using
    <code>calendar__cell--selected</code>
    ,
    <code>calendar__range</code>
    ,
    <code>calendar__range--start</code>
    ,
    <code>calendar__range-end</code>
    and clipped text.
  </p>

