import { urls } from "../../../../data";
<div id="menu">
  <section-header/>

  <p>
    <strong>NOTE:</strong>
    Only limited JavaScript behaviour has been implemented in these
    examples. For detailed behaviour requirements, please visit our
    <a href="https://opensource.ebay.com/mindpatterns/input/menu-button/index.html">
      menu pattern
    </a>
    .
  </p>

  <h3 id="menu-default">
    Default Menu
  </h3>
  <p>
    The default menu is a
    <em>stateless</em>
    menu. Each item has a role of
    <code>menuitem</code>
    .
  </p>

  <div class="demo">
    <div class="demo__inner">
      <div class="menu">
        <div class="menu__items" role="menu">
          <div class="menu__item" role="menuitem">
            <span>Item 1</span>
          </div>
          <div class="menu__item" role="menuitem">
            <span>Item 2</span>
          </div>
          <div class="menu__item" role="menuitem" aria-disabled="true">
            <span>Item 3</span>
          </div>
          <div class="menu__item" role="menuitem">
            <span>Item 4</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <highlight-code type="html">
    <div class="menu">
      <div class="menu__items" role="menu">
        <div class="menu__item" role="menuitem">
          <span>Item 1</span>
        </div>
        <div class="menu__item" role="menuitem">
          <span>Item 2</span>
        </div>
        <div class="menu__item" role="menuitem" aria-disabled="true">
          <span>Item 3</span>
        </div>
        <div class="menu__item" role="menuitem">
          <span>Item 4</span>
        </div>
      </div>
    </div>
  </highlight-code>

  <h3 id="menu-badged">
    Badged Menu
  </h3>
  <p>
    A menu item can be badged using the
    <a href=`${urls.components}/badge`>
      badge
    </a>
    module.
  </p>
  <p>
    The menuitem element requires an additional
    <code>menu__item--badged</code>
    modifier.
  </p>

  <div class="demo">
    <div class="demo__inner">
      <span class="menu">
        <div class="menu__items" role="menu">
          <div
            aria-label="Item 1 (3 notifications)"
            class="menu__item menu__item--badged"
            role="menuitem">
            <span aria-hidden="true">
              Item 1
              <span class="badge">
                3
              </span>
            </span>
          </div>
          <div
            aria-label="Item 2 (77 notifications)"
            class="menu__item menu__item--badged"
            role="menuitem">
            <span aria-hidden="true">
              Item 2
              <span class="badge">
                77
              </span>
            </span>
          </div>
          <div class="menu__item menu__item--badged" role="menuitem">
            <span>Item 3</span>
          </div>
        </div>
      </span>
    </div>
  </div>
  <highlight-code type="html">
    <span class="menu">
      <div class="menu__items" role="menu">
        <div
          aria-label="Item 1 (3 notifications)"
          class="menu__item menu__item--badged"
          role="menuitem">
          <span aria-hidden="true">
            Item 1
            <span class="badge">
              3
            </span>
          </span>
        </div>
        <div
          aria-label="Item 2 (77 notifications)"
          class="menu__item menu__item--badged"
          role="menuitem">
          <span aria-hidden="true">
            Item 2
            <span class="badge">
              77
            </span>
          </span>
        </div>
        <div class="menu__item menu__item--badged" role="menuitem">
          <span>Item 3</span>
        </div>
      </div>
    </span>
  </highlight-code>

  <h3 id="menu-radio">
    Single-Select Menu
  </h3>
  <p>
    For single-select state, use role
    <code>menuitemradio</code>
    on each menu item.
  </p>

  <div class="demo">
    <div class="demo__inner">
      <div class="menu">
        <div class="menu__items" role="menu">
          <div
            class="menu__item"
            role="menuitemradio"
            aria-checked="true"
            data-makeup-group="sort">
            <span>Item 1</span>
            <svg
              class="icon icon--16"
              height="10"
              width="14"
              aria-hidden="true">
              <icon-symbol name="tick-16"/>
            </svg>
          </div>
          <div
            class="menu__item"
            role="menuitemradio"
            aria-checked="false"
            data-makeup-group="sort">
            <span>Item 2</span>
            <svg
              class="icon icon--16"
              height="10"
              width="14"
              aria-hidden="true">
              <icon-symbol name="tick-16"/>
            </svg>
          </div>
          <div
            class="menu__item"
            role="menuitemradio"
            aria-checked="false"
            data-makeup-group="sort">
            <span>Item 3</span>
            <svg
              class="icon icon--16"
              height="10"
              width="14"
              aria-hidden="true">
              <icon-symbol name="tick-16"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>

  <highlight-code type="html">
    <div class="menu">
      <div class="menu__items" role="menu">
        <div class="menu__item" role="menuitemradio" aria-checked="true">
          <span>Item 1</span>
          <svg class="icon icon--16" height="10" width="14" aria-hidden="true">
            <use href="#icon-tick-16"/>
          </svg>
        </div>
        <div class="menu__item" role="menuitemradio" aria-checked="false">
          <span>Item 2</span>
          <svg class="icon icon--16" height="10" width="14" aria-hidden="true">
            <use href="#icon-tick-16"/>
          </svg>
        </div>
        <div class="menu__item" role="menuitemradio" aria-checked="false">
          <span>Item 3</span>
          <svg class="icon icon--16" height="10" width="14" aria-hidden="true">
            <use href="#icon-tick-16"/>
          </svg>
        </div>
      </div>
    </div>
  </highlight-code>

