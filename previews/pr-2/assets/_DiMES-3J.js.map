import { urls } from "../../../../data";
<div id="link">
  <section-header/>

  <p>
    The link module itself does not provide any base styling of anchor tags,
    that styling instead comes from the
    <a href=`${urls.components}/global`>
      global
    </a>
    module.
  </p>

  <h3 id="link-nested">
    Nested Link
  </h3>
  <p>
    When nested amongst paragraphs of text, the anchor tag's default underline
    gives visual affordance that this selection of text is a
    <em>hyperlink</em>
    . The color of the link alone would not be sufficient affordance in
    this context and therefore the underline is required and must not be
    removed.
  </p>

  <div class="demo">
    <div class="demo__inner">
      <p>
