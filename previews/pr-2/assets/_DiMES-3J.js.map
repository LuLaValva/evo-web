import {urls} from "../../../../data";
<div id="snackbar-dialog">
  <section-header/>

    <p>
    The display of the snackbar should be toggled using the
    <code>hidden</code>
    property. Please refer to the
    <a href=`${urls.guides}/animation/#dialog-transitions`>
      Dialog Transitions
    </a>
    section for information on how to correctly trigger a CSS transition
    from a hidden state.
  </p>

  <h3 id="snackbar-dialog-default">
    Default Snackbar
  </h3>
  <p>The default snackbar displays a short, non-interactive message.</p>

  <div class="demo">
    <div class="demo__inner">
      <button
        class="btn btn--primary dialog-button"
        data-makeup-for="snackbar-dialog-1">
        Show Default Snackbar
      </button>
      <aside
        aria-label="Notification"
        aria-live="polite"
        aria-modal="false"
        class="snackbar-dialog snackbar-dialog--transition"
        id="snackbar-dialog-1"
        role="dialog"
        hidden>
        <div class="snackbar-dialog__window">
          <div class="snackbar-dialog__main">
            <p>1 item deleted from watch list.</p>
          </div>
        </div>
      </aside>
    </div>
  </div>
  <highlight-code type="html">
    <aside
      aria-label="Notification"
      aria-live="polite"
      aria-modal="false"
      class="snackbar-dialog snackbar-dialog--transition"
      role="dialog"
      hidden>
      <div class="snackbar-dialog__window">
        <div class="snackbar-dialog__main">
          <p>1 item deleted from watch list.</p>
        </div>
      </div>
    </aside>
  </highlight-code>

  <h3 id="snackbar-dialog-action">
    Action Snackbar
  </h3>
  <p>
    A snackbar can contain a single shortcut action. Typically this is an
    "undo".
  </p>
  <p>
    In order to give all users adequate time to find and reach the action, the
    snackbar DOM position must be placed closely after the users current
    location (i.e.
    <code>document.activeElement</code>
    ). This ensures a natual reading and keyboard order. In addition, an
    <code>accesskey</code>
    attribute allows quick access via the operating system's
    <a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Global_attributes/accesskey">
      access keys
    </a>
    .
  </p>

  <div class="demo">
    <div class="demo__inner">
      <button
        class="btn btn--primary dialog-button"
        data-makeup-for="snackbar-dialog-2">
        Show Action Snackbar
      </button>
      <aside
        aria-label="Notification"
        aria-live="polite"
        aria-modal="false"
        class="snackbar-dialog snackbar-dialog--transition"
        id="snackbar-dialog-2"
        role="dialog"
        hidden>
        <div class="snackbar-dialog__window">
          <div class="snackbar-dialog__main">
            <p>1 item deleted from watch list.</p>
          </div>
          <div class="snackbar-dialog__actions">
            <button accesskey="u" class="fake-link snackbar-dialog__cta">
              Undo
              <span class="clipped">
                - Access Key: U
              </span>
            </button>
          </div>
        </div>
      </aside>
    </div>
  </div>
  <highlight-code type="html">
    <aside
      aria-label="Notification"
      aria-live="polite"
      aria-modal="false"
      class="snackbar-dialog snackbar-dialog--transition"
      role="dialog"
      hidden>
      <div class="snackbar-dialog__window">
        <div class="snackbar-dialog__main">
          <p>1 item deleted from watch list.</p>
        </div>
        <div class="snackbar-dialog__actions">
          <button accesskey="u" class="fake-link snackbar-dialog__cta">
            Undo
            <span class="clipped">
              - Access Key: U
            </span>
          </button>
        </div>
      </div>
    </aside>
  </highlight-code>

  <h3 id="snackbar-dialog-stacked">
    Stacked Snackbar
  </h3>
  <p>
    The content and action can be stacked vertically by using the
    <code>snackbar-dialog__window--column</code>
    modifier.
  </p>

  <div class="demo">
    <div class="demo__inner">
      <button
        class="btn btn--primary dialog-button"
        data-makeup-for="snackbar-dialog-3">
        Show Stacked Snackbar
      </button>
      <aside
        aria-label="Notification"
        aria-live="polite"
        aria-modal="false"
        class="snackbar-dialog snackbar-dialog--transition"
        id="snackbar-dialog-3"
        role="dialog"
        hidden>
        <div class="snackbar-dialog__window snackbar-dialog__window--column">
          <div class="snackbar-dialog__main">
            <p>
              Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do
              eiusmod tempor incididunt ut labore et dolore magna aliqua.
            </p>
          </div>
          <div class="snackbar-dialog__actions">
            <button accesskey="u" class="fake-link snackbar-dialog__cta">
              Undo
              <span class="clipped">
                - Access Key: U
              </span>
            </button>
          </div>
        </div>
      </aside>
    </div>
  </div>
  <highlight-code type="html">
    <aside
      aria-label="Notification"
      aria-live="polite"
      aria-modal="false"
      class="snackbar-dialog snackbar-dialog--transition"
      role="dialog"
      hidden>
      <div class="snackbar-dialog__window snackbar-dialog__window--column">
        <div class="snackbar-dialog__main">
          <p>
            Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do
            eiusmod tempor incididunt ut labore et dolore magna aliqua.
          </p>
        </div>
        <div class="snackbar-dialog__actions">
          <button accesskey="u" class="fake-link snackbar-dialog__cta">
            Undo
            <span class="clipped">
              - Access Key: U
            </span>
          </button>
        </div>
      </div>
    </aside>
  </highlight-code>
</div>
