┌─ _1024container @ 1280px
<div>
  <div style="
    border-bottom-color: orange;
    border-bottom-style: dashed;
    border-bottom-width: 1px;
    border-left-color: orange;
    border-left-style: dashed;
    border-left-width: 1px;
    border-right-color: orange;
    border-right-style: dashed;
    border-right-width: 1px;
    border-top-color: orange;
    border-top-style: dashed;
    border-top-width: 1px;
    width: 1024px
  ">
    <div style="
      container-name: file-preview-cards-container;
      container-type: inline-size
    ">
      <ul style="
        display: grid;
        gap: var(--spacing-100);
        grid-template-columns: repeat(2, 1fr);
        list-style-type: none;
        margin-bottom: 0px;
        margin-top: 0px;
        padding-left: 0px;
        width: 100%
      ">
        <li style="
          display: flex;
          flex-direction: column;
          height: max-content
        ">
          <div style="
            aspect-ratio: 1 / 1;
            background-color: var(--file-preview-card-background-color, var(--color-background-secondary));
            border-radius: var(--file-preview-card-border-radius, var(--border-radius-100));
            display: flex;
            max-width: 396px;
            min-height: 120px;
            min-width: 120px;
            position: relative
          ">
            <img
              src="https://ir.ebaystatic.com/cr/v/c01/skin/docs/tb-real-square-pic.jpg"
              style="
                align-self: center;
                border-radius: var(--file-preview-card-border-radius, var(--border-radius-100));
                height: 100%;
                margin-bottom: auto;
                margin-left: auto;
                margin-right: auto;
                margin-top: auto;
                object-fit: contain;
                width: 100%
              "
            />
            <button style="
              align-items: center;
              background-color: var(--file-preview-card-action-background-color, var(--color-background-primary));
              border-bottom-color: transparent;
              border-bottom-left-radius: 50px;
              border-bottom-right-radius: 50px;
              border-bottom-style: solid;
              border-left-color: transparent;
              border-left-style: solid;
              border-right-color: transparent;
              border-right-style: solid;
              border-top-color: transparent;
              border-top-left-radius: 50px;
              border-top-right-radius: 50px;
              border-top-style: solid;
              display: inline-flex;
              font-family: inherit;
              height: var(--spacing-400);
              justify-content: center;
              overflow-x: hidden;
              overflow-y: hidden;
              padding-bottom: 0px;
              padding-left: 0px;
              padding-right: 0px;
              padding-top: 0px;
              position: absolute;
              right: var(--spacing-100);
              top: var(--spacing-100);
              vertical-align: text-bottom;
              width: var(--spacing-400);
              z-index: 1
            ">
              <style>@scope{:scope{
                &::after {
                  background-color: var(--color-state-layer-neutral);
                  border-bottom-left-radius: 50px;
                  border-bottom-right-radius: 50px;
                  border-top-left-radius: 50px;
                  border-top-right-radius: 50px;
                  bottom: 0px;
                  content: "";
                  left: 0px;
                  pointer-events: none;
                  position: absolute;
                  right: 0px;
                  top: 0px
                }
              }}</style>
              <svg
                height="16"
                style="
                  display: inline-block;
                  fill: var(--color-foreground-primary);
                  max-width: 75%;
                  pointer-events: none;
                  position: relative;
                  stroke-width: 0;
                  stroke: currentcolor;
                  vertical-align: middle
                "
                width="16"
              >
                <use href="#icon-overflow-vertical-16"/>
              </svg>
            </button>
          </div>
        </li>
        <li style="
