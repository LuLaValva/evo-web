<div>
  <div dir="rtl">
    <span style="
      display: inline-flex;
      position: relative;
      vertical-align: text-bottom
    ">
      <input
        checked
        style="
          font-size: 100%;
          height: 18px;
          margin-bottom: 0px;
          margin-left: 0px;
          margin-right: 0px;
          margin-top: 0px;
          min-width: 18px;
          opacity: 0;
          position: absolute;
          width: 18px;
          z-index: 1
        "
        type="radio"
      />
      <span
        hidden
        style="
          display: inline-flex;
          height: 18px;
          outline-offset: 1px
        "
      >
        <svg style="
          color: var(--radio-checked-color, var(--color-foreground-primary));
          display: inline-block;
          fill: currentcolor;
          height: 18px;
          pointer-events: none;
          stroke-width: 0;
          stroke: currentcolor;
          vertical-align: middle;
          width: 18px
        ">
          <use href="#icon-radio-checked-18"/>
        </svg>
      </span>
    </span>
  </div>
</div>

