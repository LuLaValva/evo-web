          fill: currentcolor;
          height: 24px;
          opacity: 0.75;
          pointer-events: none;
          stroke-width: 0;
          stroke: currentcolor;
          vertical-align: middle;
          width: 24px
        ">
          <use href="#icon-play-24"/>
        </svg>
      </button>
    </div>
  </div>
</div>

