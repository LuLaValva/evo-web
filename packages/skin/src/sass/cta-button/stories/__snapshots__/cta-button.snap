<div>
  <a style="
    align-content: center;
    align-items: center;
    background-color: var(--cta-btn-background-color, var(--color-background-primary));
    border-bottom-color: currentcolor;
    border-bottom-style: solid;
    border-bottom-width: 1px;
    border-bottom: 1px solid;
