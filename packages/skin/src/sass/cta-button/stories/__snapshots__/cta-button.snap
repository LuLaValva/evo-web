      ">
        Link
      </span>
      <svg
        height="8"
        style="
          align-self: center;
          display: inline-block;
          fill: currentcolor;
          flex-shrink: 0;
          height: 10px;
          letter-spacing: 0.12em;
          line-height: 1.5;
