<div>
  <div style="position: relative">
    <p>
      Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.
    </p>
    <div style="
      border-radius: var(--bubble-border-radius, var(--border-radius-100));
      box-shadow: var(--bubble-shadow);
      font-size: 14px;
      left: calc(50% - 200px);
      max-width: min(344px, 80vw);
      position: absolute;
      top: calc(100% + 12px);
      transform: scaleX(1);
      width: max-content;
      z-index: 1
    ">
      <span style="
        background-color: var(--tourtip-background-color, var(--color-background-inverse));
        height: 8px;
        left: calc(50% - 4px);
        position: absolute;
        top: -4px;
        transform: rotate(45deg);
        width: 8px;
        z-index: 0
      "/>
      <div style="
        background-color: var(--tourtip-background-color, var(--color-background-inverse));
        border-radius: var(--bubble-border-radius, var(--border-radius-100));
        color: var(--tourtip-foreground-color, var(--color-foreground-on-inverse));
        position: relative;
        z-index: 1
      ">
        <div style="
          display: flex;
          flex-wrap: wrap;
          overflow-wrap: anywhere;
          padding: var(--spacing-200)
        ">
          <span style="
            flex-basis: 0px;
            flex-grow: 1
          ">
            <h2 style="
              font-size: var(--font-size-large-1);
              margin: 0 0 var(--spacing-100)
            ">
              Tourtip
            </h2>
            <p style="
              margin-bottom: 0px;
              margin-top: 0px
            ">
              Here's something new to help you be successful at your task.
            </p>
          </span>
          <button style="
            align-items: center;
            align-self: flex-start;
            border-bottom-color: currentcolor;
            border-bottom-left-radius: 50px;
            border-bottom-right-radius: 50px;
            border-bottom-style: none;
            border-bottom-width: 0px;
            border-left-color: currentcolor;
            border-left-style: none;
            border-left-width: 0px;
            border-right-color: currentcolor;
            border-right-style: none;
            border-right-width: 0px;
            border-top-color: currentcolor;
            border-top-left-radius: 50px;
            border-top-right-radius: 50px;
            border-top-style: none;
            border-top-width: 0px;
            display: inline-flex;
            flex-shrink: 0;
            font-family: inherit;
            height: var(--spacing-400);
            justify-content: center;
            margin: calc(var(--spacing-100)*-1) calc(var(--spacing-100)*-1) 0 var(--spacing-100);
            outline-offset: -2px;
            overflow-x: hidden;
            overflow-y: hidden;
            padding-bottom: 0px;
            padding-left: 0px;
            padding-right: 0px;
            padding-top: 0px;
            position: relative;
            text-wrap-mode: nowrap;
            vertical-align: text-bottom;
            width: 32px
          ">
            <style>@scope{:scope{
              &::after {
                background-color: var(--color-state-layer-neutral);
                border-bottom-left-radius: 50px;
                border-bottom-right-radius: 50px;
                border-top-left-radius: 50px;
                border-top-right-radius: 50px;
                bottom: 0px;
                content: "";
                left: 0px;
                pointer-events: none;
                position: absolute;
                right: 0px;
                top: 0px
              }
            }}</style>
            <svg
              height="24"
              style="
                display: inline-block;
                fill: var(--tourtip-foreground-color, var(--color-foreground-on-inverse));
                height: 16px;
                max-width: 75%;
                pointer-events: none;
                position: relative;
                stroke-width: 0;
                stroke: currentcolor;
                vertical-align: middle;
                width: 16px
              "
              width="24"
            >
              <use href="#icon-close-16"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

