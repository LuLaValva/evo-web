<div>
  <div dir="rtl">
    <aside style="
      background-color: var(--color-background-accent);
      border-top-left-radius: var(--border-radius-100);
      border-top-right-radius: var(--border-radius-100);
      bottom: 0px;
      box-shadow: rgba(0, 0, 0, 0.28) 0px 0px 3px;
      color: var(--color-foreground-on-success);
      left: 0px;
      max-height: 40vh;
      min-width: 320px;
      position: fixed;
      right: 0px;
      transform: translateY(0px);
      width: 100vw;
      will-change: opacity, transform;
      z-index: 2
    ">
      <div style="padding: var(--spacing-100) var(--spacing-200) var(--spacing-200)">
        <div style="
          align-items: center;
          display: flex
        ">
          <h2 style="
            margin-bottom: 0px;
            margin-top: 0px
          ">
            User Privacy Preferences
          </h2>
          <button style="
            align-items: center;
            align-self: flex-start;
            border-bottom-color: currentcolor;
            border-bottom-left-radius: 50px;
            border-bottom-right-radius: 50px;
            border-bottom-style: none;
            border-bottom-width: 0px;
            border-left-color: currentcolor;
            border-left-style: none;
            border-left-width: 0px;
            border-right-color: currentcolor;
            border-right-style: none;
            border-right-width: 0px;
            border-top-color: currentcolor;
            border-top-left-radius: 50px;
            border-top-right-radius: 50px;
            border-top-style: none;
            border-top-width: 0px;
            color: var(--color-foreground-on-success);
            display: inline-flex;
            flex-shrink: 0;
            font-family: inherit;
            height: 40px;
            justify-content: center;
            margin-inline-start: auto;
            overflow-x: hidden;
            overflow-y: hidden;
            padding-bottom: 0px;
            padding-left: 0px;
            padding-right: 0px;
            padding-top: 0px;
            position: relative;
            vertical-align: text-bottom;
            width: 40px
          ">
            <style>@scope{:scope{
              &::after {
                background-color: var(--color-state-layer-neutral);
                border-bottom-left-radius: 50px;
                border-bottom-right-radius: 50px;
                border-top-left-radius: 50px;
                border-top-right-radius: 50px;
                bottom: 0px;
                content: "";
                left: 0px;
                pointer-events: none;
                position: absolute;
                right: 0px;
                top: 0px
              }
            }}</style>
            <svg style="
              display: inline-block;
              fill: currentcolor;
              height: 16px;
              max-width: 100%;
              pointer-events: none;
              position: relative;
              stroke-width: 0;
              stroke: currentcolor;
              vertical-align: middle;
              width: 16px
            ">
              <use href="#icon-close-16"/>
            </svg>
          </button>
        </div>
        <div>
          <p>
            We detected something unusual about a recent sign-in to your eBay account.
                            To help keep you safe, we recommend you change the password.
          </p>
        </div>
        <div style="
          display: flex;
          justify-content: flex-end
        ">
          <button style="
            align-content: center;
            align-items: center;
            border-bottom-color: currentcolor;
            border-bottom-style: solid;
            border-bottom-width: 1px;
            border-bottom: 1px solid;
            border-left-color: currentcolor;
            border-left-style: solid;
            border-left-width: 1px;
            border-right-color: currentcolor;
            border-right-style: solid;
            border-right-width: 1px;
            border-top-color: currentcolor;
            border-top-style: solid;
            border-top-width: 1px;
            border-top: 1px solid;
            color: var(--color-background-primary);
            font-family: inherit;
            font-size: var(--font-size-body);
            font-weight: 700;
            margin-inline-end: var(--spacing-100);
            min-height: 40px;
            min-width: 88px;
            outline-offset: 2px;
            overflow-x: hidden;
            overflow-y: hidden;
            padding-bottom: 0px;
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 0px;
            position: relative;
            transition: all var(--motion-duration-short-3) var(--motion-easing-quick-enter);
            vertical-align: bottom
          ">
            <style>@scope{:scope{
              &::after {
                background-color: var(--color-state-layer-neutral);
                bottom: 0px;
                content: "";
                left: 0px;
                pointer-events: none;
                position: absolute;
                right: 0px;
                top: 0px
              }
              &::first-letter {text-decoration-line: underline}
            }}</style>
            Dismiss
          </button>
          <button style="
            align-content: center;
            align-items: center;
            background-color: var(--color-background-primary);
            border-bottom-color: currentcolor;
            border-bottom-style: solid;
            border-bottom-width: 1px;
            border-bottom: 1px solid;
            border-left-color: currentcolor;
            border-left-style: solid;
            border-left-width: 1px;
            border-right-color: currentcolor;
            border-right-style: solid;
            border-right-width: 1px;
            border-top-color: currentcolor;
            border-top-style: solid;
            border-top-width: 1px;
            border-top: 1px solid;
            color: var(--color-foreground-accent);
            font-family: inherit;
            font-size: var(--font-size-body);
            font-weight: 700;
            min-height: 40px;
            min-width: 88px;
            outline-offset: 2px;
            overflow-x: hidden;
