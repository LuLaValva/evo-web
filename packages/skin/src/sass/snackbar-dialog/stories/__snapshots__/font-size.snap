┌─ action @ 320px
<div>
  <div>
    <aside style="
      background-color: var(--snackbar-dialog-background-color, var(--color-background-inverse));
      bottom: 40px;
      box-shadow: rgba(0, 0, 0, 0.28) 0px 0px 3px;
      color: var(--snackbar-dialog-foreground-color, var(--color-foreground-on-inverse));
      left: var(--spacing-100);
      margin-bottom: auto;
      margin-left: auto;
      margin-right: auto;
      margin-top: auto;
      max-height: 40vh;
      max-width: 448px;
      position: fixed;
      right: var(--spacing-100);
      transform: translateY(0px);
      will-change: opacity, transform;
      z-index: 2
    ">
      <div style="
        display: flex;
        margin: var(--spacing-200) var(--spacing-300)
      ">
        <div style="margin-inline-end: var(--spacing-400)">
          <p style="
            margin-bottom: 0px;
            margin-top: 0px
          ">
            1 item deleted from watch list.
          </p>
        </div>
        <div style="margin-inline-start: auto">
          <button style="
            border-bottom-width: 0px;
            border-left-width: 0px;
            border-right-width: 0px;
            border-top-width: 0px;
            color: var(--snackbar-dialog-foreground-color, var(--color-foreground-on-inverse));
            font-family: inherit;
            font-size: inherit;
            padding-bottom: 0px;
            padding-left: 0px;
            padding-right: 0px;
            padding-top: 0px
          ">
            <style>@scope{:scope{
              &::first-letter {text-decoration-line: underline}
            }}</style>
            Undo
          </button>
        </div>
      </div>
    </aside>
  </div>
</div>

