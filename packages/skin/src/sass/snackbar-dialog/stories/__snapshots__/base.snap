          font-family: inherit;
          font-size: inherit;
          padding-bottom: 0px;
          padding-left: 0px;
          padding-right: 0px;
          padding-top: 0px
        ">
          <style>@scope{:scope{
            &::first-letter {text-decoration-line: underline}
          }}</style>
          Undo
        </button>
      </div>
    </div>
  </aside>
</div>

