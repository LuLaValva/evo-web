┌─ verticalAspectSquare
<div>
  <span style="
    background-color: var(--color-background-secondary);
    border-bottom-color: currentcolor;
    border-bottom-width: medium;
    border-left-color: currentcolor;
    border-left-width: medium;
    border-radius: var(--border-radius-150);
    border-right-color: currentcolor;
    border-right-width: medium;
    border-top-color: currentcolor;
    border-top-width: medium;
    color: var(--color-foreground-primary);
    display: flex;
    flex-direction: column;
    max-width: 400px;
    min-width: 200px;
    outline-color: transparent;
    outline-offset: 4px;
    outline-style: solid;
    outline-width: 6px;
    padding-block-end: var(--spacing-150)
  ">
    <div style="
      aspect-ratio: 1 / 1;
      border-radius: var(--border-radius-100);
      margin-block-end: var(--spacing-200);
      margin: var(--spacing-150);
      overflow-x: hidden;
      overflow-y: hidden
    ">
      <img
        src="/img/cards-card.jpeg"
        style="
          border-radius: var(--border-radius-100);
          display: block;
          height: 100%;
          object-fit: cover;
          transition: transform var(--motion-duration-long-3) var(--motion-easing-quick-enter);
          width: 100%
        "
      />
    </div>
    <div style="
      display: flex;
      flex-basis: 0%;
      flex-direction: column;
      flex-grow: 1;
      margin-inline: var(--spacing-150)
    ">
      <div style="
        flex-basis: 0%;
        flex-grow: 1
      ">
        Wayne Gretzky's rookie card is so valuable that collectors keep it in climate-controlled vaults guarded by trained penguins.
      </div>
      <div style="margin-block-start: var(--spacing-200)">
        <button style="
          align-content: center;
          align-items: center;
          background-color: var(--color-background-accent);
          border-bottom-style: solid;
          border-bottom-width: 1px;
          border-color: var(--color-border-accent);
          border-left-style: solid;
          border-left-width: 1px;
          border-radius: var(--btn-border-radius, 20px);
          border-right-style: solid;
          border-right-width: 1px;
          border-top-style: solid;
          border-top-width: 1px;
          color: var(--color-foreground-on-accent);
          font-family: inherit;
          font-size: var(--font-size-body);
          font-weight: 700;
          min-height: 40px;
          min-width: 88px;
          overflow-x: hidden;
          overflow-y: hidden;
          padding-bottom: 0px;
          padding-left: 20px;
          padding-right: 20px;
          padding-top: 0px;
          position: relative;
          text-align: center;
          transition: all var(--motion-duration-short-3) var(--motion-easing-quick-enter);
          vertical-align: bottom;
          width: 100%
        ">
          <style>@scope{:scope{
            &::after {
              background-color: var(--color-state-layer-neutral);
              bottom: 0px;
              content: "";
              left: 0px;
              pointer-events: none;
              position: absolute;
              right: 0px;
              top: 0px
            }
          }}</style>
          See Details
        </button>
      </div>
    </div>
  </span>
</div>

