┌─ internallyActionable
<div>
  <span style="
    background-color: var(--color-background-secondary);
    border-bottom-color: currentcolor;
    border-bottom-width: medium;
    border-image-outset: initial;
    border-image-repeat: initial;
    border-image-slice: initial;
    border-image-source: initial;
    border-image-width: initial;
    border-left-color: currentcolor;
    border-left-width: medium;
    border-radius: var(--border-radius-150);
    border-right-color: currentcolor;
    border-right-width: medium;
    border-top-color: currentcolor;
    border-top-width: medium;
    color: var(--color-foreground-primary);
    display: flex;
    flex-direction: column;
    max-width: 400px;
    min-width: 200px;
    outline-color: transparent;
    outline-offset: 4px;
    outline-style: solid;
    outline-width: 6px;
    padding-block-end: var(--spacing-150)
  ">
    <div style="
      aspect-ratio: 16 / 9;
      border-radius: var(--border-radius-100);
      margin-block-end: var(--spacing-200);
      margin: var(--spacing-150);
      overflow-x: hidden;
      overflow-y: hidden
    ">
      <img
        src="/img/cards-card.jpeg"
        style="
          border-radius: var(--border-radius-100);
          display: block;
          height: 100%;
          object-fit: cover;
          transition: transform var(--motion-duration-long-3) var(--motion-easing-quick-enter);
          width: 100%
        "
      />
    </div>
    <div style="
      display: flex;
      flex-basis: 0%;
      flex-direction: column;
      flex-grow: 1;
      margin-inline: var(--spacing-150)
    ">
      <div style="
        flex-basis: 0%;
        flex-grow: 1
      ">
        Hockey cards collected by enthusiasts who treat them like fine wine – stored in temperature-controlled cellars and discussed in hushed, reverent tones.
      </div>
      <div style="margin-block-start: var(--spacing-200)">
        <button
          disabled
          style="
            align-content: center;
            align-items: center;
            background-color: var(--btn-primary-disabled-background-color, var(--color-foreground-disabled));
            border-bottom-color: currentcolor;
            border-bottom-style: solid;
            border-bottom-width: 1px;
            border-color: var(--btn-primary-disabled-border-color, var(--color-foreground-disabled));
            border-left-color: currentcolor;
            border-left-style: solid;
            border-left-width: 1px;
            border-radius: var(--btn-border-radius, 20px);
            border-right-color: currentcolor;
            border-right-style: solid;
            border-right-width: 1px;
            border-top-color: currentcolor;
            border-top-style: solid;
            border-top-width: 1px;
            color: var(--btn-primary-foreground-color, var(--color-foreground-on-accent));
            font-family: inherit;
            font-size: var(--font-size-body);
            font-weight: 700;
            min-height: 40px;
            min-width: 88px;
            overflow-x: hidden;
            overflow-y: hidden;
            padding-bottom: 0px;
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 0px;
            position: relative;
            transition: all var(--motion-duration-short-3) var(--motion-easing-quick-enter);
            vertical-align: bottom;
            width: 100%
          "
        >
          <style>@scope{:scope{
            &::after {
              background-color: var(--color-state-layer-neutral);
              bottom: 0px;
              content: "";
              left: 0px;
              pointer-events: none;
              position: absolute;
              right: 0px;
              top: 0px
            }
          }}</style>
          See Details
        </button>
      </div>
    </div>
  </span>
</div>

┌─ selfActionableButton
<div>
  <button
    disabled
    style="
      background-color: var(--color-background-secondary);
      border-bottom-color: currentcolor;
      border-bottom-style: none;
      border-bottom-width: medium;
      border-image-outset: initial;
      border-image-repeat: initial;
      border-image-slice: initial;
      border-image-source: initial;
      border-image-width: initial;
      border-left-color: currentcolor;
      border-left-style: none;
      border-left-width: medium;
      border-radius: var(--border-radius-150);
      border-right-color: currentcolor;
      border-right-style: none;
      border-right-width: medium;
      border-top-color: currentcolor;
      border-top-style: none;
      border-top-width: medium;
      color: var(--color-foreground-primary);
      display: flex;
      filter: grayscale(1);
      flex-direction: column;
      font-family: inherit;
      font-size: inherit;
      line-height: inherit;
      max-width: 400px;
      min-width: 200px;
      opacity: 0.5;
      outline-color: transparent;
      outline-offset: 4px;
      outline-style: solid;
      outline-width: 6px;
      padding-block-end: var(--spacing-150);
      padding-bottom: 0px;
      padding-left: 0px;
      padding-right: 0px;
      padding-top: 0px;
      pointer-events: none;
      text-align: start;
      transition: transform var(--motion-duration-medium-3) var(--motion-easing-quick-enter), box-shadow var(--motion-duration-medium-3) var(--motion-easing-quick-enter)
    "
  >
    <div style="
      aspect-ratio: 16 / 9;
      border-radius: var(--border-radius-100);
      margin-block-end: var(--spacing-200);
      margin: var(--spacing-150);
      overflow-x: hidden;
      overflow-y: hidden
    ">
      <img
        src="/img/cards-card.jpeg"
        style="
          border-radius: var(--border-radius-100);
          display: block;
          height: 100%;
          object-fit: cover;
          transition: transform var(--motion-duration-long-3) var(--motion-easing-quick-enter);
          width: 100%
        "
      />
    </div>
    <div style="
      display: flex;
      flex-basis: 0%;
      flex-direction: column;
      flex-grow: 1;
      margin-inline: var(--spacing-150)
    ">
      <div style="
        flex-basis: 0%;
        flex-grow: 1
      ">
        Hockey cards collected by enthusiasts who treat them like fine wine – stored in temperature-controlled cellars and discussed in hushed, reverent tones.
      </div>
    </div>
  </button>
</div>

