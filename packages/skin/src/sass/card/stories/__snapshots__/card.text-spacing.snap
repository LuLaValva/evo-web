┌─ horizontal
<div>
  <span style="
    background-color: var(--color-background-secondary);
    border-bottom-color: currentcolor;
    border-bottom-width: medium;
    border-left-color: currentcolor;
    border-left-width: medium;
    border-right-color: currentcolor;
    border-right-width: medium;
    border-top-color: currentcolor;
    border-top-width: medium;
    color: var(--color-foreground-primary);
    display: flex;
    letter-spacing: 0.12em;
    line-height: 1.5;
    max-width: 100%;
    min-width: 200px;
    outline-color: transparent;
    outline-offset: 4px;
    outline-style: solid;
    outline-width: 6px;
    padding-block-end: var(--spacing-150);
    width: 100%;
    word-spacing: 0.16em
  ">
    <div style="
      aspect-ratio: 1 / 1;
      letter-spacing: 0.12em;
      line-height: 1.5;
      margin: var(--spacing-150);
      max-width: 160px;
      min-width: 90px;
      overflow-x: hidden;
      overflow-y: hidden;
      width: 25%;
      word-spacing: 0.16em
    ">
      <img
        src="/img/cards-card.jpeg"
        style="
          aspect-ratio: 1 / 1;
          display: block;
          height: auto;
          letter-spacing: 0.12em;
          line-height: 1.5;
          object-fit: cover;
          transition: transform var(--motion-duration-long-3) var(--motion-easing-quick-enter);
          width: 100%;
          word-spacing: 0.16em
        "
      />
    </div>
    <div style="
      display: flex;
      flex-basis: 0%;
      flex-direction: column;
      flex-grow: 1;
      letter-spacing: 0.12em;
      line-height: 1.5;
      margin-block-start: var(--spacing-150);
      margin-inline: var(--spacing-150);
      word-spacing: 0.16em
    ">
      <div style="
        align-items: center;
        display: flex;
        font-weight: 700;
        letter-spacing: 0.12em;
        line-height: 1.5;
        margin-block-end: var(--spacing-100);
        word-spacing: 0.16em
      ">
        <svg
          height="16"
          style="
            display: inline-block;
            fill: currentcolor;
            letter-spacing: 0.12em;
            line-height: 1.5;
            pointer-events: none;
            stroke-width: 0;
            stroke: currentcolor;
            vertical-align: middle;
            word-spacing: 0.16em
          "
          width="16"
        >
          <use
            href="#icon-authenticity-guarantee-filled-16"
            style="
              letter-spacing: 0.12em;
              line-height: 1.5;
              word-spacing: 0.16em
            "
          />
        </svg>
        <span style="
          letter-spacing: 0.12em;
          line-height: 1.5;
          word-spacing: 0.16em
        ">
          Authenticity Guaranteed
        </span>
      </div>
      <h3 style="
        font-size: var(--font-size-large-1);
        letter-spacing: 0.12em;
        line-height: 1.5;
        margin-block-end: var(--spacing-50);
        margin-bottom: 0px;
        margin-top: 0px;
        word-spacing: 0.16em
      ">
        Authentic Rookie Cards
      </h3>
      <div style="
        flex-basis: 0%;
        flex-grow: 1;
        letter-spacing: 0.12em;
        line-height: 1.5;
        word-spacing: 0.16em
      ">
        This legendary rookie card collection features future Hall of Famers back when their biggest concern was remembering to smile for the camera.
      </div>
      <div style="
        letter-spacing: 0.12em;
        line-height: 1.5;
        margin-block-start: var(--spacing-200);
        word-spacing: 0.16em
      ">
        <button style="
          align-content: center;
          align-items: center;
          background-color: var(--color-background-accent);
          border-bottom-color: currentcolor;
          border-bottom-style: solid;
          border-bottom-width: 1px;
          border-bottom: 1px solid;
          border-left-color: currentcolor;
          border-left-style: solid;
          border-left-width: 1px;
          border-right-color: currentcolor;
          border-right-style: solid;
          border-right-width: 1px;
          border-top-color: currentcolor;
          border-top-style: solid;
          border-top-width: 1px;
          border-top: 1px solid;
          color: var(--color-foreground-on-accent);
          font-family: inherit;
          font-size: var(--font-size-body);
          font-weight: 700;
          letter-spacing: 0.12em;
          line-height: 1.5;
          min-height: 40px;
          min-width: 88px;
          overflow-x: hidden;
          overflow-y: hidden;
          padding-bottom: 0px;
          padding-left: 20px;
          padding-right: 20px;
          padding-top: 0px;
          position: relative;
          transition: all var(--motion-duration-short-3) var(--motion-easing-quick-enter);
          vertical-align: bottom;
          word-spacing: 0.16em
        ">
          <style>@scope{:scope{
            &::after {
              background-color: var(--color-state-layer-neutral);
              bottom: 0px;
              content: "";
              left: 0px;
              pointer-events: none;
              position: absolute;
              right: 0px;
              top: 0px
            }
          }}</style>
          See Details
        </button>
      </div>
    </div>
  </span>
</div>

