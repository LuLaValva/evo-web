          word-spacing: 0.16em
        "
        width="24"
      >
        <use
          href="#icon-the-ebay-vault-24"
          style="
            letter-spacing: 0.12em;
            line-height: 1.5;
            word-spacing: 0.16em
          "
        />
      </svg>
      <h3 style="
