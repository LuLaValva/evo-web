┌─ base @ 320px
<div>
  <div style="
    align-items: flex-start;
    background-color: var(--dialog-scrim-color-show);
    bottom: 0px;
    display: flex;
    justify-content: center;
    left: 0px;
    position: fixed;
    right: 0px;
    top: 0px;
    will-change: background-color;
    z-index: 100000
  ">
    <div style="
      background-color: var(--dialog-window-background-color, var(--color-background-primary));
      border-radius: var(--lightbox-border-radius, var(--border-radius-100));
      display: flex;
      flex-direction: column;
      flex-grow: 1;
      flex-shrink: 0;
      margin-bottom: auto;
      margin-left: var(--spacing-200);
      margin-right: var(--spacing-200);
      margin-top: auto;
      max-height: 90%;
      max-width: calc(100% - 32px);
      min-height: 55px;
      min-width: 208px;
      padding: var(--spacing-200);
      will-change: opacity, transform
    ">
      <div>
        <h2 style="
          font-size: var(--font-size-large-1);
          font-weight: var(--font-weight-600);
          line-height: 28px;
          margin-bottom: 0px;
          margin-top: 0px
        ">
          Delete Address?
        </h2>
      </div>
      <div style="
        margin: var(--spacing-200) 0;
        min-height: var(--spacing-200)
      ">
        <p style="
          margin-bottom: 0px;
          margin-top: 0px
        ">
          You will permanently lose this address.
        </p>
      </div>
      <div style="text-align: right">
        <button style="
          align-content: center;
          align-items: center;
          background-color: rgba(0, 0, 0, 0);
          border-bottom-color: currentcolor;
          border-bottom-style: solid;
          border-bottom-width: 1px;
          border-left-color: currentcolor;
          border-left-style: solid;
          border-left-width: 1px;
          border-radius: var(--btn-border-radius, 20px);
          border-right-color: currentcolor;
          border-right-style: solid;
          border-right-width: 1px;
          border-top-color: currentcolor;
          border-top-style: solid;
          border-top-width: 1px;
          color: inherit;
          font-family: inherit;
          font-size: var(--font-size-body);
          min-height: 40px;
          min-width: 88px;
          padding-bottom: 0px;
          padding-left: 20px;
          padding-right: 20px;
          padding-top: 0px;
          text-align: center;
          vertical-align: bottom
        ">
          Cancel
        </button>
        <button style="
          align-content: center;
          align-items: center;
          background-color: var(--color-background-accent);
          border-bottom-style: solid;
          border-bottom-width: 1px;
          border-color: var(--color-border-accent);
          border-left-style: solid;
          border-left-width: 1px;
          border-radius: var(--btn-border-radius, 20px);
          border-right-style: solid;
          border-right-width: 1px;
          border-top-style: solid;
          border-top-width: 1px;
          color: var(--color-foreground-on-accent);
          font-family: inherit;
          font-size: var(--font-size-body);
          font-weight: 700;
          margin-left: var(--spacing-100);
          min-height: 40px;
          min-width: 88px;
          overflow-x: hidden;
          overflow-y: hidden;
          padding-bottom: 0px;
          padding-left: 20px;
          padding-right: 20px;
          padding-top: 0px;
          position: relative;
          text-align: center;
          transition: all var(--motion-duration-short-3) var(--motion-easing-quick-enter);
          vertical-align: bottom
        ">
          <style>@scope{:scope{
            &::after {
              background-color: var(--color-state-layer-neutral);
              bottom: 0px;
              content: "";
              left: 0px;
              pointer-events: none;
              position: absolute;
              right: 0px;
              top: 0px
            }
          }}</style>
          Delete
        </button>
      </div>
    </div>
  </div>
</div>

