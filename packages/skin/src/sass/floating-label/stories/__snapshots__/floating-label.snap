┌─ TextArea @ 1280px
<div>
  <span style="
    display: inline-block;
    position: relative
  ">
    <label style="
      background-color: var(--floating-label-background-color, var(--color-background-secondary));
      color: var(--floating-label-color, var(--color-foreground-secondary));
      display: inline-block;
      left: 16px;
      overflow-x: hidden;
      overflow-y: hidden;
      padding-top: 3px;
      pointer-events: none;
      position: absolute;
      text-overflow: ellipsis;
      text-wrap-mode: nowrap;
      top: -3px;
      transform-origin: left center;
      transform: scale(0.75) translateY(2px);
      width: calc(100% - 40px);
      z-index: 1
    ">
      Enter list of users
    </label>
    <span style="
      align-items: center;
      background-color: var(--textbox-background-color, var(--color-background-secondary));
      border-bottom-style: solid;
      border-bottom-width: 1px;
      border-left-style: solid;
      border-left-width: 1px;
      border-right-style: solid;
      border-right-width: 1px;
      border-top-style: solid;
      border-top-width: 1px;
      box-sizing: border-box;
      color: var(--textbox-foreground-color, var(--color-foreground-primary));
      display: inline-flex;
      font-size: var(--font-size-body);
      overflow-x: hidden;
      overflow-y: hidden;
      position: relative;
      width: fit-content
    ">
      <textarea style="
        appearance: none;
        border-bottom-color: currentcolor;
        border-bottom-style: none;
        border-bottom-width: medium;
        border-left-color: currentcolor;
        border-left-style: none;
        border-left-width: medium;
        border-right-color: currentcolor;
        border-right-style: none;
        border-right-width: medium;
        border-top-color: currentcolor;
        border-top-style: none;
        border-top-width: medium;
        color: inherit;
        flex-grow: 1;
        font-family: inherit;
        font-size: 1em;
        height: 40px;
        min-height: 200px;
        padding-top: 18px;
        padding: var(--spacing-200);
        resize: vertical;
        vertical-align: middle
      "/>
    </span>
  </span>
</div>

