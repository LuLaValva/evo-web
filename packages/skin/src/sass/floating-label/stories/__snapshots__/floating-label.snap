        position: relative
      ">
        <select style="
          appearance: none;
          background-color: var(--select-background-color, var(--color-background-secondary));
          color: inherit;
          font-family: inherit;
          font-size: 1em;
          height: 40px;
          line-height: 52px;
          padding-left: 30px;
          padding-right: var(--spacing-200);
          padding: 0 var(--spacing-400) 0 var(--spacing-200);
          vertical-align: middle
        ">
          <option selected/>
          <option label="Pick Option 1 (default)">
            Pick Option 1 (default)
          </option>
          <option label="Pick Option 2">
            Pick Option 2
          </option>
          <option label="Pick Option 3">
            Pick Option 3
          </option>
        </select>
        <svg
          height="8"
          style="
            display: inline-block;
            fill: currentcolor;
            height: 100%;
            left: 16px;
            pointer-events: none;
            position: absolute;
            stroke-width: 0;
            stroke: currentcolor;
            top: 0px;
            vertical-align: middle;
            width: 12px
          "
          width="8"
        >
          <use href="#icon-chevron-down-12"/>
        </svg>
      </span>
    </span>
  </div>
</div>

