<div>
  <span style="display: inline-flex">
    <span style="
      display: inline-flex;
      position: relative;
      vertical-align: bottom
    ">
      <button style="
        align-content: center;
        align-items: center;
        background-color: var(--listbox-button-background-color, var(--color-background-secondary));
        border-bottom-color: inherit;
        border-bottom-left-radius: 8px;
        border-bottom-style: solid;
        border-bottom-width: 1px;
        border-bottom: 1px solid;
        border-left-color: inherit;
        border-left-style: solid;
        border-left-width: 1px;
        border-right-color: inherit;
        border-right-style: none;
        border-right-width: 1px;
        border-top-color: inherit;
        border-top-left-radius: 8px;
        border-top-style: solid;
        border-top-width: 1px;
        border-top: 1px solid;
        color: var(--listbox-button-foreground-color, var(--color-foreground-primary));
        font-family: inherit;
        font-size: var(--font-size-body);
        max-width: 100%;
        min-height: 40px;
        min-width: 64px;
        overflow-x: hidden;
        overflow-y: hidden;
        padding-bottom: 0px;
        padding-inline: var(--spacing-200) var(--spacing-100);
        padding-left: 15px;
        padding-right: 15px;
        padding-top: 0px;
        position: relative;
        vertical-align: bottom
      ">
        <style>@scope{:scope{
          &::after {
            background-color: var(--color-state-layer-neutral);
            bottom: 0px;
            content: "";
            left: 0px;
            pointer-events: none;
            position: absolute;
            right: 0px;
            top: 0px
          }
        }}</style>
        <span style="
          align-items: center;
          display: flex;
          justify-content: space-between;
          width: 100%
        ">
          <span style="
            font-weight: 700;
            margin-right: auto
          ">
            <svg
              focusable="false"
              height="18"
              style="
                display: inline-block;
                height: 18px;
                max-height: 48px;
                max-width: 64px;
                pointer-events: none;
                stroke-width: 0;
                vertical-align: middle;
                width: 24px
              "
              width="24"
            >
              <use href="#flag-us"/>
            </svg>
          </span>
          <svg
            focusable="false"
            height="10"
            style="
              align-self: center;
              display: inline-block;
              fill: currentcolor;
              height: 12px;
              margin-inline-start: var(--spacing-50);
              pointer-events: none;
              stroke-width: 0;
              stroke: currentcolor;
              vertical-align: middle;
              width: 12px
            "
            width="14"
          >
            <use href="#icon-chevron-down-12"/>
          </svg>
        </span>
      </button>
      <div style="
        background-color: var(--color-background-elevated);
        box-shadow: var(--bubble-shadow);
        box-sizing: border-box;
        left: 0px;
        max-height: 400px;
        min-width: 100%;
        overflow-y: auto;
        position: absolute;
        top: calc(100% + 4px);
        width: auto;
        z-index: 2
      ">
        <div>
          <div style="
            border-bottom-style: solid;
