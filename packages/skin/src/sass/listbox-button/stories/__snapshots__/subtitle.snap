<div>
  <span style="
    display: inline-block;
    line-height: normal;
    position: relative;
    vertical-align: bottom
  ">
    <button style="
      align-content: center;
      align-items: center;
      background-color: rgba(0, 0, 0, 0);
      border-bottom-style: solid;
      border-bottom-width: 1px;
      border-color: var(--listbox-button-border-color, var(--color-border-medium));
      border-left-style: solid;
      border-left-width: 1px;
      border-radius: var(--expand-btn-border-radius, var(--border-radius-50));
      border-right-style: solid;
      border-right-width: 1px;
      border-top-style: solid;
      border-top-width: 1px;
      color: inherit;
      font-family: inherit;
      font-size: var(--font-size-body);
      max-width: 100%;
      min-height: 40px;
      min-width: 88px;
      overflow-x: hidden;
      overflow-y: hidden;
      padding-bottom: 0px;
      padding-left: 15px;
      padding-right: 15px;
      padding-top: 0px;
      position: relative;
      text-align: center;
      vertical-align: bottom
    ">
      <style>@scope{:scope{
        &::after {
          background-color: var(--color-state-layer-neutral);
          bottom: 0px;
          content: "";
          left: 0px;
          pointer-events: none;
          position: absolute;
          right: 0px;
          top: 0px
        }
      }}</style>
      <span style="
        align-items: center;
        display: flex;
        justify-content: space-between;
        width: 100%
      ">
        <span style="
          color: var(--listbox-button-label-color, var(--color-foreground-secondary));
          margin-right: 3px
        ">
          Color:
        </span>
        <span style="
          font-weight: 700;
          margin-right: auto
        ">
          Blue
        </span>
        <svg
          height="8"
          style="
            align-self: center;
            display: inline-block;
            fill: currentcolor;
            height: 12px;
            margin-inline-start: 8px;
            pointer-events: none;
            stroke-width: 0;
            stroke: currentcolor;
            vertical-align: middle;
            width: 12px
          "
          width="8"
        >
          <use href="#icon-chevron-down-12"/>
        </svg>
      </span>
    </button>
  </span>
</div>

