<div>
  <div style="
    border-bottom-color: orange;
    border-bottom-style: dashed;
    border-bottom-width: 1px;
    border-left-color: orange;
    border-left-style: dashed;
    border-left-width: 1px;
    border-right-color: orange;
    border-right-style: dashed;
    border-right-width: 1px;
    border-top-color: orange;
    border-top-style: dashed;
    border-top-width: 1px;
    width: 1280px
  ">
    <div style="
      container-name: toggle-buttons-container;
      container-type: inline-size
    ">
      <ul style="
        display: grid;
        grid-auto-rows: 1fr;
        grid-template-columns: repeat(var(--row-list-toggle-buttons-min), 1fr);
        list-style-type: none;
        margin-bottom: 0px;
        margin-top: 0px;
        padding-left: 0px;
        width: 100%
      ">
        <li style="
          display: inline-block;
          min-height: var(--toggle-button-height-min);
          width: 100%
        ">
          <button style="
            background-color: var(--color-background-primary);
            border: 1px solid var(--color-border-medium);
            box-shadow: transparent 0px 0px 0px 1px;
            color: var(--color-foreground-primary);
            display: inline-flex;
            font-family: inherit;
            font-size: var(--font-size-body);
            height: 100%;
            justify-content: left;
            max-width: 100%;
            min-height: var(--toggle-button-height-min);
            min-width: auto;
            padding: 0 var(--spacing-200);
            vertical-align: top;
            width: 100%
          ">
            <span style="
              align-self: flex-start;
              margin-bottom: var(--spacing-200);
              margin-right: var(--spacing-200);
              margin-top: var(--spacing-200);
              pointer-events: none
            ">
              <span style="
                display: inline-block;
                height: 56px;
                pointer-events: none;
                width: 56px
              ">
                <img
                  height=56
                  src="https://ir.ebaystatic.com/cr/v/c01/skin/docs/tb-profile-pic.jpg"
                  style="
                    height: 100%;
                    max-height: 56px;
                    max-width: 56px;
                    pointer-events: none
                  "
                  width=42
                />
              </span>
            </span>
            <span style="
              align-self: flex-start;
              display: flex;
              flex-direction: column;
              pointer-events: none;
              text-align: left
            ">
              <span style="
                font-size: var(--font-size-medium);
                font-weight: 700;
                line-height: var(--font-size-large-2);
                margin-bottom: var(--spacing-50);
                margin-top: var(--spacing-200);
                pointer-events: none
              ">
                List Layout Title
              </span>
              <span style="
                color: var(--color-foreground-secondary);
                line-height: var(--font-size-large-1);
                margin-bottom: var(--spacing-200);
                pointer-events: none
              ">
                Subtitle
              </span>
            </span>
          </button>
        </li>
