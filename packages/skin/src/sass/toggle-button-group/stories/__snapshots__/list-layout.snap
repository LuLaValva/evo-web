          border: 1px solid var(--color-border-medium);
          box-shadow: transparent 0px 0px 0px 1px;
          color: var(--color-foreground-primary);
          display: inline-flex;
          font-family: inherit;
          font-size: var(--font-size-body);
          height: 100%;
          justify-content: left;
          max-width: 100%;
          min-height: var(--toggle-button-height-min);
          min-width: auto;
          padding: 0 var(--spacing-200);
          vertical-align: top;
          width: 100%
        ">
          <span style="
            align-self: center;
            display: flex;
            flex-direction: column;
            pointer-events: none;
            text-align: left
          ">
            <span style="
              font-size: var(--font-size-medium);
              font-weight: 700;
              line-height: var(--font-size-large-2);
              margin-bottom: auto;
              margin-top: auto;
              pointer-events: none;
              text-align: center;
              width: 100%
            ">
              Title
            </span>
          </span>
        </button>
      </li>
      <li style="
        display: inline-block;
        min-height: var(--toggle-button-height-min);
        width: 100%
      ">
        <button style="
          background-color: var(--color-background-primary);
          border: 1px solid var(--color-border-medium);
          box-shadow: transparent 0px 0px 0px 1px;
          color: var(--color-foreground-primary);
          display: inline-flex;
          font-family: inherit;
          font-size: var(--font-size-body);
          height: 100%;
          justify-content: left;
          max-width: 100%;
          min-height: var(--toggle-button-height-min);
          min-width: auto;
          padding: 0 var(--spacing-200);
          vertical-align: top;
          width: 100%
        ">
          <span style="
            align-self: center;
            display: flex;
            flex-direction: column;
            pointer-events: none;
            text-align: left
          ">
            <span style="
              font-size: var(--font-size-medium);
              font-weight: 700;
              line-height: var(--font-size-large-2);
              margin-bottom: auto;
              margin-top: auto;
              pointer-events: none;
              text-align: center;
              width: 100%
            ">
              Title
            </span>
          </span>
        </button>
      </li>
    </ul>
  </div>
</div>

