<div>
  <div style="
    background-color: var(--section-notice-default-background-color, var(--color-background-secondary));
    border-radius: var(--section-notice-border-radius, var(--border-radius-50));
    display: grid;
    font-size: var(--font-size-body);
    grid-template-columns: 32px auto auto;
    margin-bottom: 8px;
    margin-top: 8px;
    padding-bottom: 16px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 16px
  ">
    <div style="
      grid-column-start: 1;
      grid-row-start: 1;
      height: var(--spacing-200);
      margin-inline-end: var(--spacing-200);
      margin-top: 1px
    ">
      <svg style="
        display: inline-block;
        fill: currentcolor;
        height: 16px;
        pointer-events: none;
        stroke-width: 0;
        stroke: currentcolor;
        vertical-align: top;
        width: 16px
      ">
        <use href="#icon-confirmation-filled-16"/>
      </svg>
    </div>
    <div style="
      grid-column-start: 2;
      grid-row-start: 1;
      margin-inline-end: var(--spacing-200)
    ">
      <p style="
        font-size: var(--font-size-body);
        margin-bottom: 0px;
        margin-top: 0px
      ">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit.
      </p>
    </div>
  </div>
</div>

