<div>
  <div dir="rtl">
    <div style="max-width: 480px">
      <ul style="
        margin-bottom: 0px;
        margin-top: 0px;
        padding-left: 0px
      ">
        <li>
          <style>@scope{:scope{
            &::marker {
              content: "";
              font-size: 0px
            }
          }}</style>
          <button style="
            align-items: center;
            background-color: var(--list-background-color, var(--color-background-primary));
            border-bottom-color: currentcolor;
            border-bottom-style: none;
            border-bottom-width: medium;
            border-left-color: currentcolor;
            border-left-style: none;
            border-left-width: medium;
            border-right-color: currentcolor;
            border-right-style: none;
            border-right-width: medium;
            border-top-color: currentcolor;
            border-top-style: none;
            border-top-width: medium;
            color: var(--color-foreground-primary);
            display: inline-flex;
            font-family: inherit;
            font-size: var(--font-size-medium);
            margin-block-end: 1px;
            margin-block-start: 1px;
            min-height: var(--spacing-600);
            overflow-x: hidden;
            overflow-y: hidden;
            padding: var(--spacing-150) var(--spacing-200);
            position: relative;
            text-align: right;
            width: 100%
          ">
            <style>@scope{:scope{
              &::after {
                background-color: var(--color-state-layer-neutral);
                bottom: 0px;
                content: "";
                left: 0px;
                pointer-events: none;
                position: absolute;
                right: 0px;
                top: 0px
              }
            }}</style>
            <span style="margin-inline-end: var(--spacing-200)">
              <svg
                height="16"
                style="
                  display: inline-block;
                  fill: currentcolor;
                  height: 16px;
                  pointer-events: none;
                  stroke-width: 0;
                  stroke: currentcolor;
                  vertical-align: middle;
                  width: 16px
                "
                width="16"
              >
                <use href="#icon-folder-16"/>
              </svg>
            </span>
            Button
          </button>
        </li>
        <li>
          <style>@scope{:scope{
