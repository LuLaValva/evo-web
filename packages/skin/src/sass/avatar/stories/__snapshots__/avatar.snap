┌─ base
<div>
  <div style="
    align-items: center;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    display: inline-flex;
    font-size: var(--font-size-large-2);
    font-weight: var(--font-weight-600);
    height: 48px;
    justify-content: center;
    line-height: 48px;
    overflow-x: hidden;
    overflow-y: hidden;
    position: relative;
    width: 48px
  ">
    <style>@scope{:scope{
      &::after {
        background-color: rgba(0, 0, 0, 0.05);
        bottom: 0px;
        content: "";
        display: block;
        left: 0px;
        pointer-events: none;
        position: absolute;
        right: 0px;
        top: 0px
      }
    }}</style>
    <span>
      E
    </span>
  </div>
</div>

