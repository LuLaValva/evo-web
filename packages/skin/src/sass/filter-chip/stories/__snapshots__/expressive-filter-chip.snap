    ">
      <style>@scope{:scope{
        &::after {
          background-color: rgba(0, 0, 0, 0.05);
          background-position-x: initial;
          background-position-y: initial;
          bottom: 0px;
          content: "";
          display: block;
          left: 0px;
          pointer-events: none;
          position: absolute;
          right: 0px;
