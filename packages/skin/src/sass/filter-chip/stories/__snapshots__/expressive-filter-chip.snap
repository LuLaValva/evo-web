┌─ anchor
<div>
  <a
    href="https://www.ebay.com"
    style="
      align-items: center;
      background-color: var(--color-background-primary);
      background-position-x: 50%;
      background-position-y: center;
      background-repeat: no-repeat;
      background-size: 0px 100%;
      border-radius: var(--border-radius-150);
      border: 1px solid var(--color-border-medium);
      box-sizing: border-box;
      color: var(--color-foreground-primary);
      display: inline-flex;
      font-size: var(--font-size-body);
      gap: var(--spacing-75);
      height: 40px;
      justify-content: space-between;
      max-width: 296px;
      min-width: 32px;
      overflow-x: hidden;
      overflow-y: hidden;
      padding: 0 var(--spacing-150);
      position: relative;
      text-decoration-color: rgb(0, 0, 0);
      text-decoration-line: none;
      transition: all var(--motion-duration-short-3) var(--motion-easing-quick-enter);
      vertical-align: bottom
    "
  >
    <style>@scope{:scope{
      &::after {
        background-color: var(--color-state-layer-neutral);
        bottom: 0px;
        content: "";
        left: 0px;
        pointer-events: none;
        position: absolute;
        right: 0px;
        top: 0px
      }
    }}</style>
    <span style="
      align-items: center;
      border-bottom-left-radius: 8px;
      border-bottom-right-radius: 8px;
      border-top-left-radius: 8px;
      border-top-right-radius: 8px;
      display: flex;
      justify-content: center;
      margin-inline-start: -8px;
      overflow-x: hidden;
      overflow-y: hidden;
      position: relative
    ">
      <style>@scope{:scope{
        &::after {
          background-color: rgba(0, 0, 0, 0.05);
          background-position-x: initial;
          background-position-y: initial;
          bottom: 0px;
          content: "";
          display: block;
          left: 0px;
          pointer-events: none;
          position: absolute;
          right: 0px;
          top: 0px
        }
      }}</style>
      <img
        src="https://ir.ebaystatic.com/cr/v/c01/skin/docs/dog_profile_optimized.jpg"
        style="
          display: inline-block;
          height: var(--spacing-400);
          max-height: 100%;
          max-width: 100%;
          object-fit: cover;
          width: var(--spacing-400)
        "
      />
    </span>
    <span style="
      overflow-x: hidden;
      overflow-y: hidden;
      padding: var(--spacing-75) 0;
      text-overflow: ellipsis;
      text-wrap-mode: nowrap;
      white-space-collapse: collapse
    ">
      Football
    </span>
  </a>
</div>

