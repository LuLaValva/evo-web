      "
      width="16"
    >
      <use href="#icon-sneaker-16"/>
    </svg>
    <span style="
      overflow-x: hidden;
      overflow-y: hidden;
      padding: var(--spacing-75) 0;
      text-overflow: ellipsis;
      text-wrap-mode: nowrap
    ">
      Football
      <span style="
        border-bottom-color: currentcolor;
        border-left-color: currentcolor;
        border-right-color: currentcolor;
        border-top-color: currentcolor;
        clip-path: inset(50%);
        height: 1px;
        overflow-x: hidden;
        overflow-y: hidden;
        position: absolute;
        text-wrap-mode: nowrap;
        width: 1px
      ">
        - Selected
      </span>
    </span>
  </a>
</div>

