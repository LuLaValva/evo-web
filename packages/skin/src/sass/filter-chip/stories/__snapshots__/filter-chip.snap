  ">
    <style>@scope{:scope{
      &::after {
        background-color: var(--color-state-layer-neutral-on-strong);
        bottom: 0px;
        content: "";
        left: 0px;
        pointer-events: none;
        position: absolute;
        right: 0px;
        top: 0px
      }
    }}</style>
