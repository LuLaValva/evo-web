┌─ RTL @ 1280px
<div>
  <div dir="rtl">
    <span style="
      color: var(--select-foreground-color, var(--color-foreground-primary));
      display: inline-block;
      font-size: var(--font-size-body);
      position: relative
    ">
      <select style="
        appearance: none;
        background-color: var(--select-background-color, var(--color-background-secondary));
        color: inherit;
        font-family: inherit;
        font-size: 1em;
        height: 40px;
        padding-left: 30px;
        padding-right: var(--spacing-200);
        padding: 0 var(--spacing-400) 0 var(--spacing-200);
        vertical-align: middle
      ">
        <option
          label="Option 1"
          selected
        >
          Option 1
        </option>
        <option label="Option 2">
          Option 2
        </option>
        <option label="Option 3">
          Option 3
        </option>
      </select>
      <svg
        height="8"
        style="
          display: inline-block;
          fill: currentcolor;
          height: 100%;
          left: 16px;
          pointer-events: none;
          position: absolute;
          stroke-width: 0;
          stroke: currentcolor;
          top: 0px;
          vertical-align: middle;
          width: 12px
        "
        width="8"
      >
        <use href="#icon-chevron-down-12"/>
      </svg>
    </span>
  </div>
</div>

