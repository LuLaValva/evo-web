        order: -1;
        overflow-x: hidden;
        overflow-y: hidden;
        padding-bottom: 0px;
        padding-inline-start: var(--spacing-200);
        padding-left: 0px;
        padding-right: 0px;
        padding-top: 0px;
        position: relative;
        transform: scale(1);
        transition: transform var(--motion-duration-short-3) var(--motion-easing-standard);
        vertical-align: text-bottom;
        width: 32px
      ">
        <style>@scope{:scope{
          &::after {
            background-color: var(--color-state-layer-neutral);
            border-bottom-left-radius: 50px;
            border-bottom-right-radius: 50px;
            border-top-left-radius: 50px;
            border-top-right-radius: 50px;
            bottom: 0px;
            content: "";
            left: 0px;
            pointer-events: none;
            position: absolute;
            right: 0px;
            top: 0px
          }
        }}</style>
        <svg
          height="24"
          style="
            color: var(--color-foreground-primary);
            display: inline-flex;
            fill: currentcolor;
            height: 1lh;
            max-width: 100%;
            pointer-events: none;
            position: relative;
            stroke-width: 0;
            stroke: currentcolor;
            vertical-align: middle
          "
          width="24"
        >
          <use href="#icon-delete-24"/>
        </svg>
      </button>
      <button style="
        align-items: center;
        border-bottom-color: transparent;
        border-bottom-left-radius: 50px;
        border-bottom-right-radius: 50px;
        border-bottom-style: solid;
        border-left-color: transparent;
        border-left-style: solid;
        border-right-color: transparent;
        border-right-style: solid;
        border-top-color: transparent;
        border-top-left-radius: 50px;
        border-top-right-radius: 50px;
        border-top-style: solid;
        display: inline-flex;
        font-family: inherit;
        height: 32px;
        justify-content: center;
        margin-inline-start: calc(var(--spacing-100)*-1);
        overflow-x: hidden;
        overflow-y: hidden;
        padding-bottom: 0px;
        padding-left: 0px;
        padding-right: 0px;
        padding-top: 0px;
        position: relative;
        transform: scale(1);
        transition: transform var(--motion-duration-short-3) var(--motion-easing-standard);
        vertical-align: text-bottom;
        width: 32px
      ">
        <style>@scope{:scope{
          &::after {
            background-color: var(--color-state-layer-neutral);
            border-bottom-left-radius: 50px;
            border-bottom-right-radius: 50px;
            border-top-left-radius: 50px;
            border-top-right-radius: 50px;
            bottom: 0px;
            content: "";
            left: 0px;
            pointer-events: none;
            position: absolute;
            right: 0px;
            top: 0px
          }
        }}</style>
        <svg
          height="24"
          style="
            color: var(--color-foreground-primary);
            display: inline-flex;
            fill: currentcolor;
            height: 1lh;
            max-width: 100%;
            pointer-events: none;
            position: relative;
            stroke-width: 0;
            stroke: currentcolor;
            vertical-align: middle
          "
          width="24"
        >
          <use href="#icon-add-24"/>
        </svg>
      </button>
    </span>
  </span>
</div>

