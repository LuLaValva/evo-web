            border-left-style: solid;
            border-right-color: transparent;
            border-right-style: solid;
            border-top-color: transparent;
            border-top-left-radius: 50px;
            border-top-right-radius: 50px;
            border-top-style: solid;
            display: inline-flex;
            flex-shrink: 0;
            font-family: inherit;
            height: 20px;
            justify-content: center;
            letter-spacing: 0.12em;
            line-height: 1.5;
            margin-left: var(--spacing-200);
            min-width: 20px;
            outline-offset: 2px;
            padding-bottom: 0px;
            padding-left: 0px;
            padding-right: 0px;
            padding-top: 0px;
            position: relative;
            vertical-align: text-bottom;
            width: 20px;
            word-spacing: 0.16em
          ">
            <style>@scope{:scope{
              &::after {
                background-color: var(--color-state-layer-neutral);
                border-bottom-left-radius: 50px;
                border-bottom-right-radius: 50px;
                border-top-left-radius: 50px;
                border-top-right-radius: 50px;
                bottom: 0px;
                content: "";
                left: 0px;
                pointer-events: none;
                position: absolute;
                right: 0px;
                top: 0px
              }
            }}</style>
            <svg
              height="24"
              style="
                display: inline-block;
                fill: var(--color-foreground-primary);
                height: 16px;
                letter-spacing: 0.12em;
                line-height: 1.5;
                max-width: 100%;
                pointer-events: none;
                position: relative;
                stroke-width: 0;
                stroke: currentcolor;
                vertical-align: middle;
                width: 16px;
                word-spacing: 0.16em
              "
              width="24"
            >
              <use
                href="#icon-close-16"
                style="
                  letter-spacing: 0.12em;
                  line-height: 1.5;
                  word-spacing: 0.16em
                "
              />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </span>
</div>

