<div>
  <fieldset style="
    border-bottom-width: 0px;
    border-left-width: 0px;
    border-right-width: 0px;
    border-top-width: 0px;
    padding-bottom: 0px;
    padding-left: 0px;
    padding-right: 0px;
    padding-top: 0px
  ">
    <legend style="
      clip-path: inset(50%);
      height: 1px;
      margin-bottom: var(--spacing-100);
      overflow-x: hidden;
      overflow-y: hidden;
      padding-left: 0px;
      padding-right: 0px;
      position: absolute;
      text-wrap-mode: nowrap;
      width: 1px
    ">
      Account Type
