<div>
  <button style="
    align-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-bottom-color: currentcolor;
    border-bottom-style: solid;
    border-bottom-width: 1px;
    border-left-color: currentcolor;
    border-left-style: solid;
    border-left-width: 1px;
    border-radius: var(--btn-border-radius, 20px);
    border-right-color: currentcolor;
    border-right-style: solid;
    border-right-width: 1px;
    border-top-color: currentcolor;
    border-top-style: solid;
    border-top-width: 1px;
    color: inherit;
    font-family: inherit;
    font-size: var(--font-size-body);
    letter-spacing: 0.12em;
    line-height: 1.5;
    min-height: 40px;
    min-width: 88px;
    padding-bottom: 0px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 0px;
    text-align: center;
    vertical-align: bottom;
    word-spacing: 0.16em
  ">
    <span style="
      align-items: center;
      display: flex;
      justify-content: center;
      letter-spacing: 0.12em;
      line-height: 1.5;
      width: 100%;
      word-spacing: 0.16em
    ">
      <svg
        height="16"
        style="
          align-self: center;
          display: inline-block;
          fill: currentcolor;
          letter-spacing: 0.12em;
          line-height: 1.5;
          margin-inline-end: 8px;
          pointer-events: none;
          stroke-width: 0;
          stroke: currentcolor;
          vertical-align: middle;
          word-spacing: 0.16em
        "
        width="16"
      >
        <use
          href="#icon-settings-16"
          style="
            letter-spacing: 0.12em;
            line-height: 1.5;
            word-spacing: 0.16em
          "
        />
      </svg>
      <span style="
        letter-spacing: 0.12em;
        line-height: 1.5;
        word-spacing: 0.16em
      ">
        Button
      </span>
    </span>
  </button>
</div>

