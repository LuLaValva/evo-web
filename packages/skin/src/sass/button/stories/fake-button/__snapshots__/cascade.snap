┌─ RTL @ 1280px
<div>
  <div dir="rtl">
    <a style="
      align-content: center;
      align-items: center;
      border-bottom-style: solid;
      border-bottom-width: 1px;
      border-bottom: 1px solid;
      border-left-style: solid;
      border-left-width: 1px;
      border-right-style: solid;
      border-right-width: 1px;
      border-top-style: solid;
      border-top-width: 1px;
      border-top: 1px solid;
      box-sizing: border-box;
      color: inherit;
      display: inline-block;
      font-family: inherit;
      font-size: var(--font-size-body);
      min-height: 40px;
      min-width: 88px;
      padding-left: 20px;
      padding-right: 20px;
      text-align: center;
      vertical-align: bottom
    ">
      <span style="
        align-items: center;
        display: flex;
        justify-content: center;
        width: 100%
      ">
        <svg
          height="16"
          style="
            align-self: center;
            display: inline-block;
            fill: currentcolor;
            height: 16px;
            margin-inline-end: 8px;
            pointer-events: none;
            stroke-width: 0;
            stroke: currentcolor;
            vertical-align: middle;
            width: 16px
          "
          width="16"
        >
          <use href="#icon-settings-16"/>
        </svg>
        <span>
          Fake Button
        </span>
      </span>
    </a>
  </div>
</div>

