┌─ busy @ 1280px
<div>
  <button style="
    align-content: center;
    align-items: center;
    background-color: var(--btn-secondary-destructive-background-color, transparent);
    border-bottom-style: solid;
    border-bottom-width: 1px;
    border-color: var(--btn-secondary-destructive-border-color, var(--color-border-attention));
    border-left-style: solid;
    border-left-width: 1px;
    border-radius: var(--btn-border-radius, 20px);
    border-right-style: solid;
    border-right-width: 1px;
    border-top-style: solid;
    border-top-width: 1px;
    color: var(--btn-secondary-destructive-foreground-color, var(--color-foreground-attention));
    font-family: inherit;
    font-size: var(--font-size-body);
    min-height: 40px;
    min-width: 88px;
    overflow-x: hidden;
    overflow-y: hidden;
    padding-bottom: 0px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 0px;
    position: relative;
    text-align: center;
    transition: all var(--motion-duration-short-3) var(--motion-easing-quick-enter);
    vertical-align: bottom
  ">
    <style>@scope{:scope{
      &::after {
        background-color: var(--color-state-layer-neutral);
        bottom: 0px;
        content: "";
        left: 0px;
        pointer-events: none;
        position: absolute;
        right: 0px;
        top: 0px
      }
    }}</style>
    <span style="
      --color-spinner-icon-background: #f39fb0;
      --color-spinner-icon-foreground: #e0103a;
      animation-duration: 1.5s;
      animation-iteration-count: infinite;
      animation-name: spin;
      animation-timing-function: cubic-bezier(0.7, 0.2, 0.3, 0.73);
      display: inline-block;
      height: 24px;
      margin-bottom: -4px;
      margin-top: -4px;
      width: 24px
    ">
      <svg style="
        align-self: center;
        display: inline-block;
        fill: currentcolor;
        height: inherit;
        max-height: inherit;
        max-width: inherit;
        pointer-events: none;
        stroke-width: 0;
        stroke: currentcolor;
        vertical-align: middle;
        width: inherit
      ">
        <use href="#icon-spinner-24"/>
      </svg>
    </span>
  </button>
</div>

