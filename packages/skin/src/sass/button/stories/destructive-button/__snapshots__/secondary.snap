      border-top-width: 1px;
      color: var(--btn-secondary-disabled-foreground-color, var(--color-background-disabled));
      font-family: inherit;
      font-size: var(--font-size-body);
      min-height: 40px;
      min-width: 88px;
      overflow-x: hidden;
      overflow-y: hidden;
      padding-bottom: 0px;
      padding-left: 20px;
      padding-right: 20px;
      padding-top: 0px;
      position: relative;
      text-align: center;
      text-decoration-color: rgb(0, 0, 0);
      transition: all var(--motion-duration-short-3) var(--motion-easing-quick-enter);
      vertical-align: bottom
    "
  >
    <style>@scope{:scope{
      &::after {
        background-color: var(--color-state-layer-neutral);
        bottom: 0px;
        content: "";
        left: 0px;
        pointer-events: none;
        position: absolute;
        right: 0px;
        top: 0px
      }
    }}</style>
    <span style="
      align-items: center;
      display: flex;
      justify-content: center;
      width: 100%
    ">
      <svg
        height="16"
        style="
          align-self: center;
          display: inline-block;
          fill: var(--btn-secondary-disabled-foreground-color, var(--color-foreground-disabled));
          margin-inline-end: 8px;
          pointer-events: none;
          stroke-width: 0;
          stroke: currentcolor;
          vertical-align: middle
        "
        width="16"
      >
        <use href="#icon-close-16"/>
      </svg>
      <span>
        Destructive Button
      </span>
    </span>
  </button>
</div>

