    font-size: var(--font-size-body);
    grid-template-columns: 32px auto auto auto;
    letter-spacing: 0.12em;
    line-height: 1.5;
    margin: var(--spacing-100) 0;
    padding: var(--spacing-200);
    word-spacing: 0.16em
  ">
    <div style="
      grid-column-start: 1;
      grid-row-start: 1;
      letter-spacing: 0.12em;
      line-height: 1.5;
      margin-inline-end: var(--spacing-200);
      word-spacing: 0.16em
    ">
      <svg
        height="16"
        role="img"
        style="
          color: var(--page-notice-information-icon-color, var(--color-foreground-on-success));
          display: inline-block;
          fill: currentcolor;
          letter-spacing: 0.12em;
          line-height: 1.5;
          pointer-events: none;
          stroke-width: 0;
          stroke: currentcolor;
          vertical-align: middle;
          word-spacing: 0.16em
        "
        width="16"
      >
        <use
          href="#icon-information-filled-16"
          style="
            letter-spacing: 0.12em;
            line-height: 1.5;
            word-spacing: 0.16em
          "
        />
      </svg>
    </div>
    <div style="
      grid-column-start: 2;
      grid-row-start: 1;
      letter-spacing: 0.12em;
      line-height: 1.5;
      margin-inline-end: var(--spacing-200);
      word-spacing: 0.16em
    ">
      <h3 style="
        font-size: var(--font-size-body);
        font-weight: 700;
        letter-spacing: 0.12em;
        line-height: 1.5;
        margin-bottom: 0px;
        margin-top: 1px;
        word-spacing: 0.16em
      ">
        Notice Title
      </h3>
      <p style="
        font-size: var(--font-size-body);
        letter-spacing: 0.12em;
        line-height: 1.5;
        margin-bottom: 2em;
        margin: var(--spacing-50) 0 0;
        word-spacing: 0.16em
      ">
        Opt into eBay payments before Jan 12th to pay no selling fees.
      </p>
    </div>
    <p style="
      grid-column-start: 2;
      grid-row-start: 2;
      justify-self: flex-start;
      letter-spacing: 0.12em;
      line-height: 1.5;
      margin-bottom: 2em;
      margin-right: var(--spacing-200);
      margin-top: var(--spacing-200);
      word-spacing: 0.16em
    ">
      <a
        href="https://www.ebay.com"
        style="
          color: var(--page-notice-color, var(--color-foreground-on-inverse));
          font-size: var(--font-size-body);
          letter-spacing: 0.12em;
          line-height: 1.5;
          text-wrap-mode: nowrap;
          white-space-collapse: collapse;
          word-spacing: 0.16em
        "
      >
        Opt in
      </a>
    </p>
    <div style="
      grid-column-start: 4;
      grid-row-start: 1;
      letter-spacing: 0.12em;
      line-height: 1.5;
      text-align: right;
      word-spacing: 0.16em
    ">
      <button style="
        background-color: rgba(0, 0, 0, 0);
        border-bottom-color: currentcolor;
        border-bottom-style: none;
        border-bottom-width: 0px;
        border-left-color: currentcolor;
        border-left-style: none;
        border-left-width: 0px;
        border-right-color: currentcolor;
        border-right-style: none;
        border-right-width: 0px;
        border-top-color: currentcolor;
        border-top-style: none;
        border-top-width: 0px;
        color: var(--page-notice-color, var(--color-foreground-on-inverse));
        cursor: pointer;
        font-family: inherit;
        font-size: var(--font-size-body);
        font-weight: 700;
        letter-spacing: 0.12em;
        line-height: 1.5;
        padding-bottom: 0px;
        padding-left: 0px;
        padding-right: 0px;
        padding-top: 0px;
        text-decoration-line: underline;
        word-spacing: 0.16em
      ">
        <svg
          height="14"
          style="
            display: inline-block;
            fill: currentcolor;
            height: 16px;
            letter-spacing: 0.12em;
            line-height: 1.5;
            pointer-events: none;
            stroke-width: 0;
            stroke: currentcolor;
            vertical-align: middle;
            width: 16px;
            word-spacing: 0.16em
          "
          width="14"
        >
          <use
            href="#icon-close-16"
            style="
              letter-spacing: 0.12em;
              line-height: 1.5;
              word-spacing: 0.16em
            "
          />
        </svg>
      </button>
    </div>
  </section>
</div>

