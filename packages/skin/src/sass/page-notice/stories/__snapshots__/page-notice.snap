<div>
  <section style="
    background-color: var(--page-notice-information-background-color, var(--color-background-accent));
    border-bottom-style: solid;
    border-bottom-width: 1px;
    border-color: var(--page-notice-information-border-color, var(--color-border-accent));
    border-left-style: solid;
    border-left-width: 1px;
    border-right-style: solid;
    border-right-width: 1px;
    border-top-style: solid;
    border-top-width: 1px;
    color: var(--page-notice-color, var(--color-foreground-on-inverse));
    display: grid;
    font-size: var(--font-size-body);
    grid-template-columns: 32px auto auto auto;
    margin: var(--spacing-100) 0;
    padding: var(--spacing-200)
  ">
    <div style="
      grid-column-start: 1;
      grid-row-start: 1;
      margin-inline-end: var(--spacing-200)
    ">
      <svg
        height="16"
        role="img"
        style="
          color: var(--page-notice-information-icon-color, var(--color-foreground-on-success));
          display: inline-block;
          fill: currentcolor;
          pointer-events: none;
          stroke-width: 0;
          stroke: currentcolor;
          vertical-align: middle
        "
        width="16"
      >
        <use href="#icon-information-filled-16"/>
      </svg>
    </div>
    <div style="
      grid-column-start: 2;
      grid-row-start: 1;
      margin-inline-end: var(--spacing-200)
    ">
      <p style="
        font-size: var(--font-size-body);
        margin-bottom: 0px;
        margin-top: 2px
      ">
        You have opted into eBay Pay
      </p>
    </div>
    <div style="
      grid-column-start: 4;
      grid-row-start: 1;
      text-align: right
    ">
      <button style="
        background-color: rgba(0, 0, 0, 0);
        border-bottom-color: currentcolor;
        border-bottom-style: none;
        border-bottom-width: 0px;
        border-left-color: currentcolor;
        border-left-style: none;
        border-left-width: 0px;
        border-right-color: currentcolor;
        border-right-style: none;
        border-right-width: 0px;
        border-top-color: currentcolor;
        border-top-style: none;
        border-top-width: 0px;
        color: var(--page-notice-color, var(--color-foreground-on-inverse));
        font-family: inherit;
        font-size: var(--font-size-body);
        font-weight: 700;
        padding-bottom: 0px;
        padding-left: 0px;
        padding-right: 0px;
        padding-top: 0px;
        text-decoration-line: underline
      ">
        Dismiss
      </button>
    </div>
  </section>
</div>

