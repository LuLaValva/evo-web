┌─ RTL @ 320px
<div>
  <div dir="rtl">
    <section style="
      background-color: var(--page-notice-confirmation-background-color, var(--color-background-success));
      border-bottom-style: solid;
      border-bottom-width: 1px;
      border-left-style: solid;
      border-left-width: 1px;
      border-right-style: solid;
      border-right-width: 1px;
      border-top-style: solid;
      border-top-width: 1px;
      color: var(--page-notice-color, var(--color-foreground-on-inverse));
      display: grid;
      font-size: var(--font-size-body);
      grid-template-columns: 32px auto auto auto;
      margin: var(--spacing-100) 0;
      padding: var(--spacing-200)
    ">
      <div style="
        grid-column-start: 1;
        grid-row-start: 1;
        margin-inline-end: var(--spacing-200)
      ">
        <svg
          height="24"
          role="img"
          style="
            color: var(--page-notice-confirmation-icon-color, var(--color-foreground-on-success));
            display: inline-block;
            fill: currentcolor;
            height: 16px;
            pointer-events: none;
            stroke-width: 0;
            stroke: currentcolor;
            vertical-align: middle;
            width: 16px
          "
          width="24"
        >
          <use href="#icon-confirmation-filled-16"/>
        </svg>
      </div>
      <div style="
        grid-column-start: 2;
        grid-row-start: 1;
        margin-inline-end: var(--spacing-200)
      ">
        <h2 style="
          font-size: var(--font-size-body);
          font-weight: 400;
          margin-bottom: 0px;
          margin-top: 1px
        ">
          Your new listing is live.
        </h2>
      </div>
      <div style="
        grid-column-start: 4;
        grid-row-start: 1;
        margin-right: auto;
        padding-right: 16px;
        text-align: right
      ">
        <button style="
          border-bottom-width: 0px;
          border-left-width: 0px;
          border-right-width: 0px;
          border-top-width: 0px;
          color: var(--page-notice-color, var(--color-foreground-on-inverse));
          font-family: inherit;
          font-size: var(--font-size-body);
          font-weight: 700;
          padding-bottom: 0px;
          padding-left: 0px;
          padding-right: 0px;
          padding-top: 0px;
          text-decoration-line: underline
        ">
          Dismiss
        </button>
      </div>
    </section>
    <div/>
  </div>
</div>

