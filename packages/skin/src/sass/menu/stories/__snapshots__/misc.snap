┌─ badged
<div>
  <span style="
    display: inline-block;
    vertical-align: bottom
  ">
    <span style="
      background-color: var(--menu-background-color, var(--color-background-primary));
      cursor: default;
      display: inline-block
    ">
      <div style="
        background-color: initial;
        border-bottom-style: solid;
        border-bottom-width: 1px;
        border-color: var(--menu-menuitem-border-color, var(--color-background-primary));
        border-left-style: solid;
        border-left-width: 1px;
        border-right-style: solid;
        border-right-width: 1px;
        border-top-style: solid;
        border-top-width: 1px;
        box-sizing: border-box;
        color: var(--menu-menuitem-foreground-color, var(--color-foreground-primary));
        display: inline-grid;
        font-family: inherit;
        grid-template-columns: auto auto;
        justify-content: space-between;
        margin-bottom: 1px;
        overflow-x: hidden;
        overflow-y: hidden;
        padding-bottom: 8px;
        padding-left: 15px;
        padding-right: 15px;
        padding-top: 8px;
        position: relative;
        width: 100%
      ">
        <style>@scope{:scope{
          &::after {
            background-color: var(--color-state-layer-neutral);
            bottom: 0px;
            content: "";
            left: 0px;
            pointer-events: none;
            position: absolute;
            right: 0px;
            top: 0px
          }
        }}</style>
        <span style="
          flex-shrink: 0;
          text-align: left;
          text-wrap-mode: nowrap
        ">
          Button 1
          <span style="
            align-items: center;
            background-color: var(--color-background-attention);
            border-bottom-left-radius: 1.2em;
            border-bottom-right-radius: 1.2em;
            border-top-left-radius: 1.2em;
            border-top-right-radius: 1.2em;
            border: 2px solid var(--color-border-inverse);
            box-sizing: border-box;
            color: var(--color-foreground-on-attention);
            display: inline-flex;
            font-size: var(--font-size-smallest);
            height: 2.4em;
            justify-content: center;
            margin-left: var(--spacing-100);
            margin-right: var(--spacing-100);
            min-width: 2.4em;
            padding-bottom: 1px;
            padding-inline: var(--spacing-50);
            padding-left: 5px;
            padding-right: 5px;
            padding-top: 1px;
            position: absolute;
            text-wrap-mode: nowrap;
            top: 0px;
            z-index: 1
          ">
            1
