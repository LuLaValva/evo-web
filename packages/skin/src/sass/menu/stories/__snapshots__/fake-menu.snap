            font-size: var(--font-size-smallest);
            height: 2.4em;
            justify-content: center;
            margin-left: var(--spacing-100);
            margin-right: var(--spacing-100);
            min-width: 2.4em;
            padding-bottom: 1px;
            padding-inline: var(--spacing-50);
            padding-left: 5px;
            padding-right: 5px;
            padding-top: 1px;
            position: absolute;
            text-wrap-mode: nowrap;
            top: 0px;
            z-index: 1
          ">
            1
          </span>
        </span>
      </a>
