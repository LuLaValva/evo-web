        box-sizing: border-box;
        color: var(--menu-menuitem-foreground-color, var(--color-foreground-primary));
        display: inline-grid;
        font-family: inherit;
        grid-template-columns: auto auto;
        justify-content: flex-start;
        overflow-x: hidden;
        overflow-y: hidden;
        padding-bottom: 8px;
        padding-left: 15px;
        padding-right: 15px;
