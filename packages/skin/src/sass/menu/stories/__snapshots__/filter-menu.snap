        position: relative;
        width: 100%
      ">
        <style>@scope{:scope{
          &::after {
            background-color: var(--color-state-layer-neutral);
            bottom: 0px;
            content: "";
            left: 0px;
            pointer-events: none;
            position: absolute;
            right: 0px;
