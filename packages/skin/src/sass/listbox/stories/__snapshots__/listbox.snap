<div>
  <span style="
    display: inline-block;
    vertical-align: bottom
  ">
    <div style="
      background-color: var(--listbox-background-color, var(--color-background-primary));
      cursor: default
    ">
      <div style="
        border-bottom-style: solid;
        border-bottom-width: 1px;
        border-left-style: solid;
        border-left-width: 1px;
        border-right-style: solid;
        border-right-width: 1px;
        border-top-style: solid;
        border-top-width: 1px;
        box-sizing: border-box;
        color: var(--color-foreground-primary);
        display: inline-grid;
        font-family: inherit;
        grid-template-columns: auto auto;
        justify-content: space-between;
        margin-bottom: 1px;
        overflow-x: hidden;
        overflow-y: hidden;
        padding-bottom: 8px;
        padding-left: 15px;
        padding-right: 15px;
        padding-top: 8px;
        position: relative;
        width: 100%
      ">
        <style>@scope{:scope{
          &::after {
            background-color: var(--color-state-layer-neutral);
            bottom: 0px;
            content: "";
            left: 0px;
            pointer-events: none;
            position: absolute;
            right: 0px;
            top: 0px
          }
        }}</style>
        <span style="
          flex-basis: 0%;
          flex-grow: 1;
          text-wrap-mode: nowrap
        ">
          Option 1
        </span>
        <svg
          height="8"
          style="
            align-self: center;
            display: inline-block;
            fill: currentcolor;
            height: 16px;
            margin-inline-start: var(--spacing-100);
            margin-left: auto;
            margin-right: auto;
            pointer-events: none;
            stroke-width: 0;
            stroke: currentcolor;
            vertical-align: middle;
            width: 16px
          "
          width="8"
        >
          <use href="#icon-tick-16"/>
        </svg>
      </div>
