<div>
  <span style="display: inline-block">
    <ul style="
      display: flex;
      flex-wrap: wrap;
      font-size: var(--font-size-body);
      gap: var(--spacing-50);
      list-style-image: none;
      list-style-position: outside;
      list-style-type: none;
      margin-bottom: 0px;
      margin-inline-start: calc(0px - var(--spacing-200));
      margin-top: 0px;
      padding-left: 0px
    ">
      <li style="
        -webkit-tap-highlight-color: var(--color-background-secondary);
        display: inline-block;
        position: relative
      ">
        <a
          href="http://www.ebay.com"
          style="
            color: var(--tabs-item-selected-foreground-color, var(--color-foreground-primary));
            display: inline-block;
            padding: var(--spacing-150) var(--spacing-200);
            text-decoration-color: rgb(0, 0, 0);
            text-decoration-line: none
          "
        >
          <style>@scope{:scope{
            &::after {
              background-color: currentcolor;
              border-bottom-left-radius: 6px;
              border-bottom-right-radius: 6px;
              border-top-left-radius: 6px;
              border-top-right-radius: 6px;
              content: "";
              display: block;
              height: 2px;
              inset: auto var(--spacing-200) 0;
              position: absolute
            }
          }}</style>
          Fake 1
          <span style="
            border-bottom-color: currentcolor;
            border-left-color: currentcolor;
            border-right-color: currentcolor;
            border-top-color: currentcolor;
            clip-path: inset(50%);
            height: 1px;
            overflow-x: hidden;
            overflow-y: hidden;
            position: absolute;
            text-wrap-mode: nowrap;
            white-space-collapse: collapse;
            width: 1px
          ">
            - selected
          </span>
        </a>
      </li>
      <li style="
