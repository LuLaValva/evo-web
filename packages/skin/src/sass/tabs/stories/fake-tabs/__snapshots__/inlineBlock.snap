            border-bottom-color: currentcolor;
            border-left-color: currentcolor;
            border-right-color: currentcolor;
            border-top-color: currentcolor;
            clip-path: inset(50%);
            height: 1px;
            overflow-x: hidden;
            overflow-y: hidden;
            position: absolute;
            text-wrap-mode: nowrap;
            width: 1px
          ">
            - selected
          </span>
        </a>
      </li>
