┌─ textSpacing
<div>
  <div style="
    letter-spacing: 0.12em;
    line-height: 1.5;
    word-spacing: 0.16em
  ">
    <legend style="
      letter-spacing: 0.12em;
      line-height: 1.5;
      margin-bottom: var(--spacing-100);
      word-spacing: 0.16em
    ">
      Choose an Option
    </legend>
    <div style="
      display: flex;
      letter-spacing: 0.12em;
      line-height: 1.5;
      margin-bottom: 16px;
      margin-top: 16px;
      word-spacing: 0.16em
    ">
      <span style="
        display: inline-flex;
        letter-spacing: 0.12em;
        line-height: 1.5;
        position: relative;
        vertical-align: text-bottom;
        word-spacing: 0.16em
      ">
        <input
          style="
            font-size: 100%;
            height: 18px;
            letter-spacing: 0.12em;
            line-height: 1.5;
            margin-bottom: 0px;
            margin-left: 0px;
            margin-right: 0px;
            margin-top: 0px;
            min-width: 18px;
            opacity: 0;
            position: absolute;
            width: 18px;
            word-spacing: 0.16em;
            z-index: 1
          "
          type="checkbox"
        />
        <span
          hidden
          style="
            display: inline-flex;
            height: 18px;
            letter-spacing: 0.12em;
            line-height: 1.5;
            outline-offset: 1px;
            word-spacing: 0.16em
          "
        >
          <svg
            height="18"
            style="
              color: var(--checkbox-unchecked-color, var(--color-foreground-primary));
              display: inline-block;
              fill: currentcolor;
              height: 18px;
              letter-spacing: 0.12em;
              line-height: 1.5;
              pointer-events: none;
              stroke-width: 0;
              stroke: currentcolor;
              vertical-align: middle;
              width: 18px;
              word-spacing: 0.16em
            "
            width="18"
          >
            <use
              href="#icon-checkbox-unchecked-18"
              style="
                letter-spacing: 0.12em;
                line-height: 1.5;
                word-spacing: 0.16em
              "
            />
          </svg>
        </span>
      </span>
      <label style="
        letter-spacing: 0.12em;
        line-height: 1.5;
        margin-left: 4px;
        margin-right: auto;
        word-spacing: 0.16em
      ">
        Option 2
      </label>
    </div>
  </div>
</div>

