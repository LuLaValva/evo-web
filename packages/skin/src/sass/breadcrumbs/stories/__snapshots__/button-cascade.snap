<div>
  <nav style="
    color: green;
    font-size: var(--font-size-small);
    height: fit-content;
    margin-bottom: 8px;
    margin-top: 8px;
    min-height: 16px;
    overflow-x: scroll;
    padding-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    scrollbar-width: none;
    text-wrap-mode: nowrap;
    white-space-collapse: collapse
  ">
    <h2 style="
      border-bottom-color: currentcolor;
      border-left-color: currentcolor;
      border-right-color: currentcolor;
      border-top-color: currentcolor;
      clip-path: inset(50%);
      height: 1px;
      overflow-x: hidden;
      overflow-y: hidden;
      position: absolute;
      text-wrap-mode: nowrap;
      white-space-collapse: collapse;
      width: 1px
    ">
      You are here
    </h2>
    <ul style="
      display: inline-block;
      margin-bottom: 0px;
      margin-top: 0px;
      min-width: 100%;
      padding-left: 0px;
      right: 0px
    ">
      <li style="
        align-items: center;
        display: inline-flex;
        vertical-align: middle
      ">
        <button style="
          background-color: rgba(0, 0, 0, 0);
          background-position-x: initial;
          background-position-y: initial;
          border-bottom-color: currentcolor;
          border-bottom-style: none;
          border-bottom-width: medium;
          border-left-color: currentcolor;
          border-left-style: none;
          border-left-width: medium;
          border-right-color: currentcolor;
          border-right-style: none;
          border-right-width: medium;
          border-top-color: currentcolor;
          border-top-style: none;
          border-top-width: medium;
          color: inherit;
          font-family: inherit;
          font-size: 1em;
          max-width: 168px;
          outline-offset: 5px;
          overflow-x: hidden;
          overflow-y: hidden;
          padding-bottom: 0px;
          padding-left: 0px;
          padding-right: 0px;
          padding-top: 0px;
          text-overflow: ellipsis
