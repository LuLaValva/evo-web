export interface Input extends Omit<Marko.HTML.Input, "checked" | "checkedChange" | "checkedValue" | "checkedValueChange"> {
    /**
     * String enumeration of checkbox state.
     * @default "false"
     */
    checked?: Marko.HTMLAttributes["aria-checked"];
    checkedChange?: (checked: "true" | "false" | "mixed") => void;
    /** Used alongside `checkedValues` for a [controllable](https://markojs.com/docs/explanation/controllable-components) pattern that aligns with [Marko's `checkedValue` checkbox pattern](https://markojs.com/docs/reference/native-tag#input-typeradio-and-input-typecheckbox). List of _all_ "child" checkbox values */
    values?: string[];
    /** **Must** be accompanied by `values` and `checkedValuesChange` (usually via [the `:=` bind syntax](https://markojs.com/docs/reference/language#shorthand-change-handlers-two-way-binding)). Leverages [Marko's `checkedValue` checkbox pattern](https://markojs.com/docs/reference/native-tag#input-typeradio-and-input-typecheckbox) for "select/deselect all" behavior */
    checkedValues?: string[];
    checkedValuesChange?: (checkedValues: string[]) => void;
    /** If set, then will skip the mixed toggle when clicking on checkbox. Used if in some cases you want to toggle between all items selected or none. */
    skipMixed?: boolean;
    /**
     * Sets the checkbox icon. (Note: The dimensions of the checkbox will not change, but only the icon)
     * @default "regular"
     */
    size?: "regular" | "large";
}

<const/{
    class: inputClass,
    style,
    size,
    skipMixed,
    checked: inputChecked,
    checkedChange,
    values,
    checkedValues : inputCheckedValues,
    checkedValuesChange,
    onChange,
    ...htmlInput
}=input>

<let/checked=inputChecked || "false" valueChange=checkedChange>
<let/checkedValues=inputCheckedValues as string[] valueChange=checkedValuesChange>

<const/usesCheckedValue=!!(checkedValues && checkedValuesChange && values)>
<let/lastMixed=null as string[] | null>

<const/effectiveChecked=(
    usesCheckedValue
        ? checkedValues!.length >= values!.length
            ? "true"
            : checkedValues!.length === 0
            ? "false"
            : "mixed"
        : checked || "false"
)>


<span style=style class=["checkbox", inputClass]>
    <input/$checkbox
        ...htmlInput
        class="checkbox__control"
        checked=effectiveChecked !== "false"
        checkedChange(ch) {
            if (usesCheckedValue) {
                if (effectiveChecked === "true") {
                    checkedValues = [];
                } else if (effectiveChecked === "mixed") {
                    lastMixed = checkedValues!;
                    checkedValues = values!;
                } else {
                    checkedValues = lastMixed || values!;
                }
            } else {
                if (checked === "true") {
                    checked = "false";
                } else if (checked === "false") {
                    checked = "mixed";
                } else {
                    checked = "true";
                }
            }
        }
        aria-checked=effectiveChecked
        type="checkbox">
    <script>$checkbox().indeterminate = effectiveChecked === "mixed"</script>
    <span class="checkbox__icon" hidden>
        <if=effectiveChecked === "mixed">
            <if=size === "large">
                <evo-icon-checkbox-mixed-24 class="checkbox__checked"/>
            </if>
            <else>
                <evo-icon-checkbox-mixed-18 class="checkbox__checked"/>
            </else>
        </if>
        <else if=effectiveChecked === "true">
            <if=size === "large">
                <evo-icon-checkbox-checked-24 class="checkbox__checked"/>
            </if>
            <else>
                <evo-icon-checkbox-checked-18 class="checkbox__checked"/>
            </else>
        </else>
        <else>
            <if=size === "large">
                <evo-icon-checkbox-unchecked-24 class="checkbox__unchecked"/>
            </if>
            <else>
                <evo-icon-checkbox-unchecked-18 class="checkbox__unchecked"/>
            </else>
        </else>
    </span>
</span>
