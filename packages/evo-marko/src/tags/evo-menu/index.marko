import { type Input as ButtonInput } from "../evo-button/index.marko";
export interface Item extends Marko.HTML.Div {
    /** Used for tracking the selected item */
    value?: string;
    /** Render as a separator instead of an item */
    separator?: boolean;
    /** Displays [an `<evo-badge>` component](?path=/docs/graphics-icons-evo-badge--docs) after the content containing this number. */
    badgeNumber?: number;
    /** Item will not be clickable, and keyboard navigation will skip over it */
    disabled?: boolean;
}
export interface Input<
    Index extends number | string | (number | string)[],
> extends Marko.HTML.Span {
    /** If present, indicates the selected item(s) in the menu and automatically updates them on click. Use a single value for single-select, or an array for multi-select. Compares with `value` if present in `@item`, otherwise index. */
    selected?: Index;
    selectedChange?: (selected: Index) => void;
    /** Attribute tag representing a menu item */
    item?: Marko.AttrTag<Item>;
    /**
     * Setting to `"filter"` changes styles to align with filter components
     * @default "none"
     */
    variant?: "filter" | "none";
    /** Prefix built-in class names */
    classPrefix?: string;
    /** Time (ms) that users need to wait between typing characters for typeahead to reset */
    typeaheadTimeoutLength?: number;
    /** Show elements right-to-left instead of left-to-right */
    reverse?: boolean;
    /** Fixes menu in place */
    fixed?: boolean;
    /** Fix the dropdown width to match the button width */
    fixWidth?: boolean;
    /** The footer content, rendered [an `<evo-button>` component](?path=/docs/buttons-evo-button--docs). Generally used only when `variant="filter"`. */
    footerButton?: Marko.AttrTag<ButtonInput>;
}

<const/{
    class: inputClass,
    classPrefix,
    selected: inputIndex,
    selectedChange,
    reverse,
    fixed,
    fixWidth,
    footerButton,
    typeaheadTimeoutLength,
    item: items,
    variant,
    "aria-label": ariaLabel,
    "aria-labelledby": ariaLabelledby,
    ...htmlInput
}=input>
<const/isRadio=typeof inputIndex === "number" || typeof inputIndex === "string">
<const/isFilter=variant === "filter">
<const/isCheckbox=Array.isArray(inputIndex) || (isFilter && !isRadio)>
<const/isCheckable=isRadio || isCheckbox>
<const/baseClass=classPrefix || "menu">
<const/menuClass=(baseClass === "menu" ? "items" : "menu")>
<let/selected:=input.selected>

<id/menu>
<span/$el
    ...htmlInput
    class=[
        classPrefix ? `${baseClass}__menu` : "menu",
        reverse && `${baseClass}__${menuClass}--reverse`,
        fixed && `${baseClass}__${menuClass}--fixed`,
        fixWidth && `${baseClass}__${menuClass}--fix-width`,
        isFilter && `${baseClass}--filter`,
        inputClass,
    ]>
    <div
        role="menu"
        class=`${baseClass}__items`
        aria-label=ariaLabel
        aria-labelledby=ariaLabelledby
        id=menu>
        <const/$items: Iterable<HTMLElement>=$item> // TODO: remove when Marko TS works
        <evo-roving-tabindex/rovTabindex
            nodeList=$items
            selected:=selected/>
        <evo-typeahead/{ typeahead }
            nodeList=$items
            timeoutLength=typeaheadTimeoutLength/>

        <for|item, i| of=items>
            <const/{
                class: itemClass,
                value = i,
                separator,
                badgeNumber,
                disabled,
                content,
                ...htmlItem
            }=item>
            <const/itemRole=(
                (isRadio
                    ? "menuitemradio"
                    : isCheckbox
                      ? "menuitemcheckbox"
                      : "menuitem") as Marko.HTML.Div["role"]
            )>
            <const/checked=(
                Array.isArray(selected)
                    ? selected.includes(value)
                    : selected === value
            )>
            <if=separator>
                <hr class=`${baseClass}__separator` role="separator">
            </if>
            <else>
                <div/$item
                    ...htmlItem
                    class=[
                        `${baseClass}__item`,
                        itemClass,
                        badgeNumber !== undefined &&
                            `${baseClass}__item--badged`,
                    ]
                    onClick(e, target) {
                        rovTabindex.onClick(value);
                        (item.onClick || null)?.(e, target);
                    }
                    onKeyDown(e, target) {
                        rovTabindex.onKeyDown(e);
                        const newIndex = typeahead(e);
                        if (newIndex !== -1) {
                            rovTabindex.setFocusIndex(newIndex);
                        }

                        (item.onKeyDown || null)?.(e, target);
                    }
                    data-value=value
                    tabindex=(rovTabindex.isFocused(value) ? 0 : -1)
                    aria-checked=isCheckable && (checked ? "true" : "false")
                    aria-disabled=disabled && "true"
                    role=itemRole>
                    <if=isFilter>
                        <if=isRadio>
                            <evo-icon-radio-unchecked-18 class="icon--unchecked"/>
                            <evo-icon-radio-checked-18 class="icon--checked"/>
                        </if>
                        <else>
                            <evo-icon-checkbox-unchecked-18 class="icon--unchecked"/>
                            <evo-icon-checkbox-checked-18 class="icon--checked"/>
                        </else>
                    </if>
                    <span>
                        <${content}/>
                        <if=badgeNumber>
                            <evo-badge type="menu" number=badgeNumber a11yText=null/>
                        </if>
                    </span>
                    <if=!isFilter>
                        <evo-icon-tick-16/>
                    </if>
                </div>
            </else>
        </for>
    </div>
    <if=footerButton>
        <div class=`${baseClass}__footer`>
            <evo-button ...footerButton/>
        </div>
    </if>
</span>

<return=$el>