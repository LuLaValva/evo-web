import type { Input as DetailsInput } from "<evo-details>";
export interface Input<Open extends number | number[] | undefined>
    extends Omit<Marko.HTML.UL, "aria-roledescription"> {
    /**
     * Size of the details
     * @default "regular"
     */
    size?: "regular" | "large";
    /**
     * The `aria-roledescription` of the list
     *
     * English default to be overridden is `"accordion"`
     * @default "accordion"
     */
    a11yText: string;
    /** Represents an [`<evo-details>` tag](?path=/story/navigation-disclosure-evo-details--default) to be used as part of the group. */
    item?: Marko.AttrTag<
        Omit<DetailsInput, "size" | "alignment" | "open" | "openChange">
    >;
    /** The index or indices of the open items. Pass a number if only one may be open at a time, or an array for multiple */
    open?: Open;
    openChange?: (open: Open) => void;
}

<const/{
    class: inputClass,
    size,
    item: items,
    a11yText = "accordion",
    open: inputOpen,
    openChange,
    ...htmlInput
}=input>

<let/open:=input.open>
<let/interacted=false>

<ul
    ...htmlInput
    aria-roledescription=a11yText
    class=[
        "accordion",
        size === "large" && "accordion--large",
        inputClass,
        interacted && "accordion--animated",
    ]>
    <for|item, index| of=items>
        <li>
            <evo-details
                ...item
                open=(
                    Array.isArray(open) ? open.includes(index) : open === index
                )
                openChange(isOpen) {
                    interacted = true;
                    if (Array.isArray(open)) {
                        const currentOpen = open;
                        if (isOpen) {
                            if (!currentOpen.includes(index)) {
                                open = [...currentOpen, index] as Open;
                            }
                        } else {
                            open = currentOpen.filter(
                                (n) => n !== index,
                            ) as Open;
                        }
                    } else {
                        open = (isOpen ? index : -1) as Open;
                    }
                }/>
        </li>
    </for>
</ul>
