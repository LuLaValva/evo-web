export interface ListItem
    extends Marko.HTML.Button, Omit<Marko.HTML.A, "type" | `on${string}`> {
    /**
     * Override the element that the item is rendered as, instead of `<div>`
     * @default "div"
     */
    as?: keyof Marko.NativeTags;
    /** Render a separator instead of a regular list item */
    separator?: boolean;
    /** Optional leading content, rendered as a `<div>` */
    leading?: Marko.AttrTag<Marko.HTML.Div>;
    /** Optional trailing content, rendered as a `<div>` */
    trailing?: Marko.AttrTag<Marko.HTML.Div>;
}
export interface Input extends Marko.HTML.Div {
    /** Item to render in the list */
    item?: Marko.AttrTag<ListItem>;
}

<const/{ class: inputClass, style, item: items, ...htmlInput }=input>

<div ...htmlInput style=style class=["list", inputClass]>
    <ul>
        <for|item| of=items>
            <const/{
                class: itemInputClass,
                as = "div",
                separator,
                leading,
                trailing,
                ...itemInput
            }=item>
            <if=separator>
                <hr>
            </if>
            <else>
                <li>
                    <${as} ...itemInput>

                        <if=leading>
                            <div
                                ...leading
                                class=["list__leading", leading.class]/>
                        </if>
                        <div class="list__body">
                            <${item}/>
                        </div>
                        <if=trailing>
                            <div
                                ...trailing
                                class=["list__trailing", trailing.class]/>
                        </if>
                    </>
                </li>
            </else>
        </for>
    </ul>
</div>
