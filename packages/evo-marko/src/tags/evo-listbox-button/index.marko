import type { Input as ListboxInput } from "<evo-listbox>";
import { validSplit, type Input as ButtonInput } from "<evo-button>";

export interface Input<Index extends number | string>
    extends Marko.HTML.Div {
    /** The selected item in the list. Checks for equality with `value` in each `@option` */
    selected?: ListboxInput<Index>["selected"];
    selectedChange?: ListboxInput<Index>["selectedChange"];
    /** Allows control over the open state of the listbox */
    open?: boolean;
    openChange?: (newOpen: boolean) => void;
    /** Attribute tag representing a list option */
    option?: ListboxInput<Index>["option"];
    /** Used for the `name` attribute of the native `<select>` */
    name?: ListboxInput<Index>["name"];
    /**
     * If `manual` then user will need to press enter to select an item using keyboard. Otherwise `auto` will automatically select as the user presses up/down
     * @default "manual"
     */
    listSelection?: ListboxInput<Index>["listSelection"];
    /** Id of an external element to use as the prefix label for the listbox button. Should not be used with `prefixLabel` */
    prefixId?: string;
    /**
     * The text to be shown when no options are selected. Cannot be used with `floating-label`
     * @default "-"
     */
    unselectedText?: string;
    /**
     * If `form`, changes appearance to match other form-specific components for visual consistency.
     * @default "standard"
     */
    variant?: "standard" | "form";
    /** Will truncate the text of the button onto a single line, and adds an ellipsis, when the buttons text overflows */
    truncate?: boolean;
    /** Expands the button to 100% width. */
    fluid?: boolean;
    /**
     * Use `fixed` when dropdown is contained in an overflow and needs to be visible as you scroll the screen.
     * @default "absolute"
     */
    strategy?: "fixed" | "absolute";
    /** Removes button borders. */
    borderless?: boolean;
    /** The label to add that floats to the top when item is selected. Cannot be used with `prefixLabel` */
    floatingLabel?: string;
    /** Disables the button. */
    disabled?: boolean;
    /** Used for the `name` attribute of the native `<button>`. */
    buttonName?: string;
    /** Applies split button styles to the component. */
    split?: ButtonInput["split"];
    /** Applies `aria-invalid="true"` to the button, which also adjusts styles. */
    invalid?: boolean;
    /** Indicates error state _without_ a11y. Prefer `invalid` unless other accessible elements of the UI also indicate an error state */
    hasError?: boolean;
    /**
     * The clipped text for screen readers when an option is selected
     *
     * English default to be overridden is `"selected"`
     * @default "selected"
     **/
    a11ySelectedText: string;
    /** The label to add before each selected item on the button. Cannot be used with `prefixId` */
    prefixLabel?: string;
    /** The label to add after each selected item on the button. */
    postfixLabel?: string;
    /** When an option is selected, `open` is toggled to `false`. */
    collapseOnSelect?: boolean;
    /** The id of an element that describes the listbox button, applied as `aria-describedby` on the button. */
    a11yDescribedBy?: string;
}
<const/{
    name,
    class: inputClass,
    selected: inputSelected,
    selectedChange,
    open: inputOpen,
    openChange,
    borderless,
    disabled,
    fluid,
    invalid,
    buttonName,
    option: options,
    truncate,
    prefixLabel,
    prefixId,
    postfixLabel,
    unselectedText = "-",
    floatingLabel,
    collapseOnSelect,
    listSelection,
    variant,
    hasError,
    strategy,
    split,
    a11yDescribedBy,
    a11ySelectedText = "selected",
    onKeyDown,
    onFocusOut,
    ...htmlInput
}=input>
<let/selected:=input.selected>
<let/open:=input.open>
<const/optionsList=[...options || []]>
<const/selectedIndex=(
    typeof selected === "number"
        ? selected
        : optionsList.findIndex((o) => o.value === selected)
)>
<const/selectedOption=optionsList[selectedIndex]>

<id/rootId> // TODO: remove in favor of $root once Marko supports dynamic tag return
<const/$root() { return document.getElementById(rootId)! }>

<evo-expander/expander: Marko.Return<typeof import("<evo-expander>")["default"]>["value"]
    open=open
    strategy=strategy
    host=$root
    overlay=$listbox/>

<${truncate && !fluid ? "div" : "span"}
    ...htmlInput
    id=rootId
    class=[
        "listbox-button",
        inputClass,
        fluid && "listbox-button--fluid",
        variant === "form" && `listbox-button--form`,
        hasError && "listbox-button--error",
    ]
    onKeyDown(e: KeyboardEvent, el: HTMLDivElement) {
        if (open && e.key === "Escape") {
            open = false;
        }
        onKeyDown && onKeyDown(e, el);
    }
    onFocusOut(e: FocusEvent, el: HTMLDivElement) {
        if (!el.contains(e.relatedTarget as Node)) {
            open = false;
        }
        onFocusOut && onFocusOut(e, el);
    }>
    <id/labelId>
    <button
        class=[
            "listbox-button__control",
            "btn",
            validSplit.includes(split!) && `btn--split-${split}`,
            borderless ? "btn--borderless" : "btn--form",
            truncate && "btn--truncated",
            floatingLabel && "btn--floating-label",
        ]
        value=selectedOption?.value as string | undefined
        type="button"
        disabled=disabled
        name=buttonName
        aria-haspopup="listbox"
        aria-describedby=a11yDescribedBy
        aria-labelledby=prefixId ? `${prefixId} ${labelId}` : labelId
        aria-invalid=invalid && "true"
        aria-expanded=expander.ariaExpanded
        onClick() { open = !open; }>
        <span class="btn__cell">
            <if=floatingLabel>
                <span class=[
                    "btn__floating-label",
                    "btn__floating-label--animate",
                    !selectedOption && "btn__floating-label--inline",
                ]>
                    ${floatingLabel}
                </span>
            </if>
            <else if=prefixLabel>
                <span class="btn__label">
                    ${prefixLabel}
                </span>
            </else>

            <if=selectedOption>
                <if=selectedOption.icon>
                    <span ...selectedOption.icon id=labelId class="btn__text"/>
                </if>
                <span id=labelId class="btn__text">
                    <${selectedOption.content}/>
                </span>
                <if=postfixLabel>
                    <span class="btn__postfix-label">
                        ${" "}${postfixLabel}
                    </span>
                </if>
            </if>
            <else if=!floatingLabel>
                <span id=labelId class="btn__text">
                    ${unselectedText}
                </span>
            </else>
            <evo-icon-chevron-down-16/>
        </span>
    </button>
    <evo-listbox/$listbox
        style=expander.floatingStyles
        class=[
            "listbox-button__listbox",
            strategy === "fixed" && "listbox-button__listbox--fixed",
        ]
        selected:=selected
        name=name
        listSelection=listSelection
        a11ySelectedText=a11ySelectedText
        onClick() {
            if (collapseOnSelect) open = false;
        }
        option=input.option/>
</>
