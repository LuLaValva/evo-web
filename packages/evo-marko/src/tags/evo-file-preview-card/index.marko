import { type Input as IconButtonInput } from "<evo-icon-button>"

export interface FilePreviewCardEvent {
    file: File;
    menuAction: FilePreviewCardMenuAction;
    originalEvent: Event;
}
export type FilePreviewCardMenuAction = {
    event: string;
    label: string;
};
export type FilePreviewCardFile = (
    | File
    | {
          name: string;
          type?: File["type"];
          src?: string;
      }
);
export interface Input extends Marko.HTML.Div {
    /** Override the tag used to wrap this component */
    as?: keyof Marko.NativeTags;
    /** File object, can be raw platform `File` or an object containing `name`, `type`, and a `src` for the preview */
    file?: FilePreviewCardFile;
    /** Status of the file, can be `"uploading"` or `undefined` */
    status?: "uploading";
    /** If present, wrap the card in an `<a>` tag */
    href?: string;
    /** File information. If not present, this will default to the file extension */
    infoText?: string;
    /** The delete button. Requires `a11yText` and `onClick` attributes which will attach to the icon-button. */
    deleteAction?: Marko.AttrTag<IconButtonInput>;
    /** Array of menu actions, containing `event` and `label` */
    menuActions?: FilePreviewCardMenuAction[];
    /** Additional action. Requires `a11yText` and `onClick` attributes, and an icon in `content` */
    action?: Marko.AttrTag<IconButtonInput>;
    /** The "see more" button. Requires `a11yText` and `onClick` attributes which will attach to the icon-button. */
    seeMoreAction?: Marko.AttrTag<IconButtonInput>;
    /** The "cancel upload" button. Requires `a11yText` and `onClick` attributes which will attach to the icon-button. */
    cancelAction?: Marko.AttrTag<IconButtonInput>;
    /** Title to display beneath the file, usually the filename */
    footerTitle?: string;
    /** Subtitle to display beneath the file title */
    footerSubtitle?: string;
}

<const/{
    cancelAction,
    deleteAction,
    file: rawFile,
    seeMoreAction,
    status,
    infoText,
    menuActions,
    footerTitle,
    footerSubtitle,
    action,
    href,
    class: inputClass,
    as: inputAs,
    ...htmlInput
}=input>

<const/name=rawFile?.name>
<const/type=(
    rawFile?.type?.startsWith("image")
        ? "image"
        : rawFile?.type?.startsWith("video")
          ? "video"
          : undefined
)>
<const/src=(
    rawFile instanceof File ? URL.createObjectURL(rawFile) : rawFile?.src
)>

<${inputAs ?? "div"} ...htmlInput class=["file-preview-card", inputClass]>
    <div class="file-preview-card__body">
        <${href ? "a" : null} href=href>
            <if=status === "uploading">
                <evo-progress-spinner
                    a11yText="uploading"
                    class="file-preview-card__asset"
                    size="large"/>
            </if>
            <else if=type === "image">
                <img
                    class={
                        "file-preview-card__asset": true,
                        "file-preview-card__asset--fade":
                            seeMoreAction !== undefined,
                    }
                    src=src
                    alt=name>
            </else>
            <else if=type === "video">
                <video class="file-preview-card__asset" src=src/>
            </else>
            <else>
                <evo-icon-file-24 class="file-preview-card__asset"/>
            </else>
        </>
        <if=seeMoreAction>
            <button
                ...seeMoreAction
                type="button"
                class=["file-preview-card__see-more", seeMoreAction.class]
                aria-label=null/>
        </if>
        <else>
            <if=status === "uploading" && cancelAction>
                <evo-icon-button
                    ...cancelAction
                    class=["file-preview-card__action", cancelAction?.class]>
                    <evo-icon-close-16/>
                </evo-icon-button>
            </if>
            <else>
                <if=menuActions?.length>
                    // TODO reenable after menu button is added
                    // <evo-menu-button
                    //     class="file-preview-card__action"
                    //     variant="overflow"
                    //     on-select("handleMenuSelect")
                    // >
                    //     <for|action| of=menuActions.concat({
                    //         event: "delete",
                    //         label: deleteText as string,
                    //     })>
                    //         <@item value=action.event>
                    //             ${action.label}
                    //         </@item>
                    //     </for>
                    // </evo-menu-button>
                </if>
                <else if=action>
                    <evo-icon-button
                        ...action
                        class=["file-preview-card__action", action.class]/>
                </else>
                <else if=deleteAction>
                    <evo-icon-button
                        ...deleteAction
                        class=["file-preview-card__action", deleteAction.class]>
                        <evo-icon-delete-16/>
                    </evo-icon-button>
                </else>
            </else>
            <if=type !== "image">
                <div class="file-preview-card__info">
                    <if=type === "video">
                        <evo-icon-play-16 class="file-preview-card__video-icon"/>
                    </if>
                    ${infoText ||
                    name?.substring(name.lastIndexOf(".") + 1).toUpperCase()}
                </div>
            </if>
        </else>
    </div>
    <if=footerTitle>
        <div class="file-preview-card__footer">
            <span>${footerTitle}</span>
            <if=footerSubtitle>
                <span>${footerSubtitle}</span>
            </if>
        </div>
    </if>
</>
