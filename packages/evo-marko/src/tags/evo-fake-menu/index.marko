export interface Item extends Marko.HTML.A {
    /** Set to `"button"` or `"submit"` to render a `<button>` instead of an `<a>` */
    type?: "button" | "submit";
    /** Whether the item represents the current page (sets `aria-current`) */
    current?: boolean;
    /** Used with `current`. When `false`, `aria-current` is set to `"true"` instead of `"page"`. */
    itemMatchesUrl?: boolean;
    /** Number to display in a badge */
    badgeNumber?: number;
    /** Whether the item is disabled */
    disabled?: boolean;
    /** When `true`, renders a visual separator instead of a menu item */
    separator?: boolean;
}
export interface Input extends Marko.HTML.Span {
    /** A menu item. Can be a link (`href`) or a button (`type="button"`). */
    item?: Marko.AttrTag<Item>;
    /** A prefix to be added to all classes (used by parent components like menu-button) */
    classPrefix?: string;
    /** Whether menu displays in reverse order */
    reverse?: boolean;
    /** Whether the menu uses fixed positioning */
    fixed?: boolean;
    /** Constrain items to the width of the button */
    fixWidth?: boolean;
}

<const/{
    class: inputClass,
    classPrefix,
    reverse,
    fixed,
    fixWidth,
    item: items,
    ...htmlInput
}=input>
<const/baseClass=(classPrefix || "fake-menu")>

<define/ItemTag|itemInput: Item|>
    <const/{
        type,
        disabled,
        href,
        ...rest
    }=itemInput>
    <if=(type === "button" || type === "submit")>
        <button
            ...rest as Marko.HTML.Button
            type=type
            disabled=disabled/>
    </if>
    <else>
        <a
            ...rest as Marko.HTML.A
            href=(disabled ? undefined : href)
            aria-disabled=(disabled && "true")/>
    </else>
</define>

<span/$el
    ...htmlInput
    class=[
        classPrefix ? `${baseClass}__menu` : "fake-menu",
        reverse && `${baseClass}__menu--reverse`,
        fixed && `${baseClass}__menu--fixed`,
        fixWidth && `${baseClass}__menu--fix-width`,
        inputClass,
    ]>
    <ul class="fake-menu__items" tabindex="-1">
        <for|item| of=items>
            <!-- Lifted out of <if>/<else> to work around Marko 6 SSR translator
                 bug with `<const/{ named, ...rest }=obj>` inside a conditional branch. -->
            <const/{
                class: itemClass,
                current,
                itemMatchesUrl,
                badgeNumber,
                separator,
                content,
                ...htmlItem
            }=item>
            <const/ariaCurrent=(current ? (itemMatchesUrl === false ? "true" as const : "page" as const) : undefined)>
            <if=separator>
                <li>
                    <hr class=`${baseClass}__separator` role="separator">
                </li>
            </if>
            <else>
                <li>
                    <ItemTag
                        ...htmlItem
                        class=[`${baseClass}__item`, itemClass]
                        aria-current=ariaCurrent>
                        <span>
                            <${content}/>
                        </span>
                        <if=badgeNumber>
                            <evo-badge type="menu" number=badgeNumber a11yText=null/>
                        </if>
                        <evo-icon-tick-16/>
                    </ItemTag>
                </li>
            </else>
        </for>
    </ul>
</span>

<return=$el>
