import {
    type Input as ButtonInput,
    validPriorities,
    validSizes,
} from "<evo-button>";
import type { Input as BadgeInput } from "<evo-badge>";
export interface Input
    extends Omit<Marko.HTML.Button, "aria-label">, Omit<Marko.HTML.A, "type" | `on${string}` | "aria-label"> {
    /** An optional badge attached to the button */
    badge?: Marko.AttrTag<Omit<BadgeInput, "a11yText" | "type">>;
    /** URL for link behavior (switches to `<a>` tag) */
    href?: string;
    /** Uses transparent styles for the button. */
    transparent?: boolean;
    /**
     * Priority of the button. Changes color and border.
     * @default "none"
     */
    priority?: ButtonInput["priority"];
    /** Alternative size for the icon button */
    size?: ButtonInput["size"];
    /** Programmatically disabled, but remains keyboard focusable */
    partiallyDisabled?: ButtonInput["partiallyDisabled"];
    /** Triggered on escape key */
    onEscape?: ButtonInput["onEscape"];
    /**
     * The `aria-label` of the button
     *
     * English default to be overridden is `"button"`
     *
     * Pass `null` explicitly _only_ if alternative accessibility information is present
     * @default "button"
     */
    a11yText: string | null;
}

<const/{
    badge,
    priority = "none",
    partiallyDisabled,
    content,
    type,
    size,
    transparent,
    class: inputClass,
    a11yText = "button",
    ...htmlInput
}=input>

<const/tagType=(input.href ? "a" : "button")>
<const/baseClassName=(input.href ? "icon-link" : "icon-btn")>

<${tagType}
    ...htmlInput
    aria-label=a11yText
    onKeyDown(e: KeyboardEvent, el: HTMLButtonElement) {
        if (e.key === "Escape" && !input.disabled) {
            input.onEscape?.(e);
        }
        input.onKeyDown && input.onKeyDown(e, el);
    }
    class=[
        inputClass,
        baseClassName,
        transparent && `${baseClassName}--transparent`,
        validPriorities.includes(priority) && `${baseClassName}--${priority}`,
        size && validSizes.includes(size) && `${baseClassName}--${size}`,
    ]
    type=tagType === "button" && (type || "button")
    aria-disabled=partiallyDisabled && "true">
    <${content}/>
    <if=badge>
        <evo-badge ...badge type="icon" a11yText=null/>
    </if>
</>
