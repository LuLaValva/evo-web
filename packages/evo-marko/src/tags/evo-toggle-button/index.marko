export interface Input extends Marko.HTML.Button {
    /** Pressed state of the button */
    pressed?: boolean;
    pressedChange?: (pressed: boolean) => void;
    /**
     * Enforced layout type of the button. Gallery layout may only be used when there is also an icon or an image.
     * @default "minimal"
     */
    layoutType?: "minimal" | "list" | "gallery";
    /** An `<evo-icon-*>` to show as the button's icon */
    icon?: Marko.AttrTag<Marko.HTML.Span>;
    /** An optional image. May be used when `<@icon>` is _not_ present */
    image?: Marko.AttrTag<{
        /** The image source URL */
        src: string;
        /** Alt text for the image */
        alt: string;
        /** Position of the image. May be any valid value for [the CSS `background-position` attribute](https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/background-position). */
        fillPlacement?: string;
    }>;
    /** An optional subtitle. */
    subtitle?: Marko.AttrTag<Marko.HTML.Span>;
}

<const/{
    class: inputClass,
    icon,
    image,
    layoutType,
    pressed: inputPressed,
    pressedChange,
    content,
    subtitle,
    title,
    onClick,
    ...htmlInput
} = input>

<let/pressed:=input.pressed>

<button
    ...htmlInput
    type="button"
    class=[
        "toggle-button",
        layoutType && `toggle-button--${layoutType}-layout`,
        inputClass,
    ]
    aria-pressed=pressed && "true"
    onClick(event, target) {
        pressed = !pressed;
        (onClick || null)?.(event, target);
    }
>
    <if=icon>
        <span ...icon class=["toggle-button__icon", icon.class]/>
    </if>
    <else if=image>
        <span class="toggle-button__image-container">
            <if=image.fillPlacement>
                <span
                    role="img"
                    aria-label=image.alt
                    class="toggle-button__image"
                    style={
                        "background-image": `url(${image.src})`,
                        "background-position": image.fillPlacement || "center",
                        "background-size": "cover",
                        "background-repeat": "no-repeat",
                    }
                />
            </if>
            <else>
                <span class="toggle-button__image">
                    <img src=image.src alt=image.alt>
                </span>
            </else>
        </span>
    </else>
    <span class="toggle-button__content">
        <span class="toggle-button__title">
            <if=title>
                ${title}
            </if>
            <else>
                <${content}/>
            </else>
        </span>
        <if=subtitle>
            <span ...subtitle class=["toggle-button__subtitle", subtitle.class]/>
        </if>
    </span>
</button>
