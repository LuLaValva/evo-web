import type { Input as TextboxInput } from "<evo-input>";
export interface Input extends Omit<TextboxInput, "size"> {
    /** Size variants. Controls the height of the component. */
    size?: "large" | "small";
    /** Localized text for the clear button. If not provided, then no clear button is rendered */
    a11yClearButtonText?: string;
    /** The id of the element that this input controls, such as the list of filtered items. */
    a11yControlsId: string;
    /**
     * Text to show when input is empty. This is not a label
     * @default "Filter"
     */
    placeholder: NonNullable<TextboxInput["placeholder"]>
}

<const/{
    class: inputClass,
    placeholder = "Filter",
    a11yClearButtonText,
    a11yControlsId,
    size,
    ...htmlInput
}=input>

<span class=["filter-input", size && `filter-input--${size}`, inputClass]>
    <evo-input
        ...htmlInput
        fluid
        type="search"
        aria-controls=a11yControlsId
        placeholder=placeholder>
        <@prefixIcon>
            <evo-icon-search-16/>
        </@prefixIcon>
        <@postfixIcon>
            <if=a11yClearButtonText>
                <evo-icon-button
                    a11yText=a11yClearButtonText
                    class="filter-input__clear-btn"
                    size="small"
                    transparent
                    onClick() {
                        (input.valueChange || null)?.("");
                    }>
                    <evo-icon-clear-16/>
                </evo-icon-button>
            </if>
        </@postfixIcon>
    </evo-input>
</span>
