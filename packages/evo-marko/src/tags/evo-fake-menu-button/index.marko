import IconButton from "<evo-icon-button>";
import Button, { type Input as ButtonInput } from "<evo-button>";
import { type Item as FakeMenuItem } from "<evo-fake-menu>";
export interface Input extends Marko.HTML.Span {
    /** Allows control over the open state of the menu */
    open?: boolean;
    openChange?: (open: boolean) => void;
    /** When an option is selected, `open` is toggled to `false`. */
    collapseOnSelect?: boolean;
    /**
     * Controls the button style
     * @default "button"
     */
    variant?: "form" | "button" | "icon";
    /** Whether button has borders. Forces `variant="button"` */
    borderless?: boolean;
    /**
     * Button priority, only used when `variant="button"`
     * @default "none"
     */
    priority?: "primary" | "secondary" | "tertiary" | "delete" | "none";
    /** The size of the button */
    size?: ButtonInput["size"];
    /** Removes the background color of the button */
    transparent?: boolean;
    /** Will disable the entire dropdown (also disables the button trigger) if set to true */
    disabled?: boolean;
    /** Hides the chevron toggle icon. */
    noToggleIcon?: boolean;
    /** Accessible label for the button, especially for cases without visible text */
    a11yText?: string;
    /** The prefix label. Rendered before the main content. */
    label?: Marko.AttrTag<Marko.HTML.Span>;
    /** Expand the menu flyout to the left */
    reverse?: boolean;
    /**
     * Positioning strategy for the dropdown. Use `fixed` when dropdown is contained in an overflow and needs to be visible as you scroll the screen.
     * @default "absolute"
     */
    strategy?: "absolute" | "fixed";
    /** Constrain items container width to button width */
    fixWidth?: boolean;
    /** Adds flip to dropdown middleware. This allows the dropdown to flip automatically if it overflows */
    flip?: boolean;
    /** A menu item. Can be a link (`href`) or a button (`type="button"`). */
    item?: Marko.AttrTag<FakeMenuItem>;
}
<const/{
    class: inputClass,
    noToggleIcon,
    reverse,
    strategy,
    fixWidth,
    flip,
    borderless,
    size,
    priority: inputPriority,
    disabled,
    variant,
    item: items,
    label,
    collapseOnSelect,
    transparent: inputTransparent,
    a11yText,
    onKeyDown,
    onFocusOut,
    ...htmlInput
}=input>

<let/open:=input.open>

<const/{
    tagName,
    transparent,
    priority,
}=(() => {
    let priority = null;
    let transparent;
    let tagName;

    if (variant === "icon") {
        tagName = IconButton;
        transparent = inputTransparent;
    } else {
        tagName = Button;
        priority = inputPriority;
    }

    return {
        tagName,
        transparent,
        priority,
    };
})()>

<evo-expander/expander
    open=open
    placement=(reverse ? "bottom-end" : "bottom-start")
    strategy=strategy
    flip=flip
    host=$root
    overlay=$menu/>

<span/$root
    ...htmlInput
    class=["fake-menu-button", inputClass]
    onKeyDown(e, el) {
        if (open && e.key === "Escape") open = false;
        onKeyDown && onKeyDown(e, el);
    }
    onFocusOut(e, el) {
        if (!el.contains(e.relatedTarget as Node)) {
            open = false;
        }
        onFocusOut && onFocusOut(e, el);
    }>
    <${tagName as any}
        class="fake-menu-button__button"
        size=size
        priority=priority as ButtonInput["priority"]
        borderless=borderless
        variant=(variant === "form" ? "form" as any : undefined)
        transparent=transparent
        aria-expanded=expander.ariaExpanded
        aria-label=a11yText
        disabled=disabled
        onClick() { open = !open; }>
        <if=label>
            <span ...label class=["menu-button-prefix-label", label.class]/>
            ${" "}
        </if>
        <if=(variant === "icon")>
            <${input.content}/>
        </if>
        <else>
            <span>
                <${input.content}/>
            </span>
            <if=!noToggleIcon>
                <evo-icon-chevron-down-12/>
            </if>
        </else>
    </>
    <evo-fake-menu/$menu:(() => HTMLSpanElement)
        style=expander.floatingStyles
        classPrefix="fake-menu-button"
        reverse=reverse
        fixed=strategy === "fixed"
        fixWidth=fixWidth
        tabindex=-1
        onClick() {
            if (collapseOnSelect) open = false;
        }
        item=items/>
</span>
