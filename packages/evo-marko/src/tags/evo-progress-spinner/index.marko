export interface Input extends Omit<Marko.HTML.Span, "role" | "aria-label"> {
    /**
     * The `aria-label` for the progress spinner
     *
     * English default to be overridden is `"Loading"`
     *
     * Pass `null` explicitly _only_ if alternative accessibility information is present
     * @default "Loading"
     */
    a11yText: string | null;
    /** Size of spinner. Default is `24`, can be `"small"` (`20`) or `"large"` (`30`). */
    size?: "large" | "small";
}
<const/{
    class: inputClass,
    a11yText = "Loading",
    size,
    ...htmlInput
}=input/>

<span
    ...htmlInput
    aria-label=a11yText
    class=[
        "progress-spinner",
        size === "large" && "progress-spinner--large",
        inputClass,
    ]
    role="img"
>
    <if=size === "large">
        <evo-icon-spinner-30/>
    </if>
    <else if=size === "small">
        <evo-icon-spinner-20/>
    </else>
    <else>
        <evo-icon-spinner-24/>
    </else>
</span>
