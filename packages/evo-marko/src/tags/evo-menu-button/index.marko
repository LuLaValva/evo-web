import IconButton from "<evo-icon-button>";
import FilterChip from "<evo-filter-chip>";
import Button, { type Input as ButtonInput } from "<evo-button>";
import { type Input as MenuInput } from "<evo-menu>";
export interface Input<
    Index extends number | string | (number | string)[],
> extends Omit<MenuInput<Index>, "variant"> {
    /** Allows control over the open state of the menu */
    open?: boolean;
    openChange?: (open: boolean) => void;
    /** When an option is selected, `open` is toggled to `false`. */
    collapseOnSelect?: boolean;
    /** Id of an external element to use as the prefix label for the menu button. Should not be used with `@label` */
    prefixId?: string;
    /**
     * Controls the button style
     * @default "button"
     */
    variant?: "form" | "button" | "icon" | "filter";
    /** Whether button has borders. Forces `variant="button"` */
    borderless?: boolean;
    /** Programmatically disabled, but remains keyboard focusable */
    partiallyDisabled?: ButtonInput["partiallyDisabled"];
    /**
     * Button priority, only used when `variant="button"`
     * @default "none"
     */
    priority?: "primary" | "secondary" | "tertiary" | "delete" | "none";
    /** The size of the button */
    size?: ButtonInput["size"];
    /** Removes the background color of the button */
    transparent?: boolean;
    /** Will disable the entire dropdown (also disables the `evo-button` label) if set to true */
    disabled?: boolean;
    /** Apply split button styles. */
    split?: ButtonInput["split"];
    /** Hides the chevron toggle icon. */
    noToggleIcon?: boolean;
    /** The prefix label. Cannot be used in conjunction with text. */
    label?: Marko.AttrTag<Marko.HTML.Span>;
    /** The footer content, rendered [an `<evo-button>` component](?path=/docs/buttons-evo-button--docs). Generally used only when `variant="filter"`. */
    footerButton?: Marko.AttrTag<ButtonInput>;
    /** Expand the menu flyout to the left */
    reverse?: boolean;
    /**
     * Positioning strategy for the dropdown. Use `fixed` when dropdown is contained in an overflow and needs to be visible as you scroll the screen.
     * @default "absolute"
     */
    strategy?: "absolute" | "fixed";
    /** Fix the dropdown width to match the button width */
    fixWidth?: boolean;
}
<const/{
    class: inputClass,
    noToggleIcon: inputNoToggleIcon,
    reverse,
    strategy,
    fixWidth,
    borderless,
    size,
    partiallyDisabled,
    footerButton,
    priority: inputPriority,
    disabled,
    variant,
    item: items,
    label,
    selected: inputSelected,
    selectedChange,
    prefixId,
    split: inputSplit,
    collapseOnSelect,
    transparent: inputTransparent,
    onKeyDown,
    onFocusOut,
    ...htmlInput
}=input>

<id/labelId>
<let/selected:=input.selected>
<let/open:=input.open>
<const/{
    tagName,
    transparent,
    isSelected,
    split,
    priority,
    noToggleIcon,
}=(() => {
    let priority = null;
    let split;
    let noToggleIcon;
    let transparent;
    let tagName;
    let isSelected;

    if (variant === "icon") {
        tagName = IconButton;
        transparent = inputTransparent;
    } else if (variant === "filter") {
        tagName = FilterChip;
        isSelected = Array.isArray(selected)
            ? selected.length > 0
            : selected !== -1;
    } else {
        tagName = Button;
        split = inputSplit;
        noToggleIcon = inputNoToggleIcon;
        priority = inputPriority;
    }

    return {
        tagName,
        split,
        isSelected,
        noToggleIcon,
        transparent,
        priority,
    };
})()>

<evo-expander/expander
    open=open
    placement=(reverse ? "bottom-end" : "bottom-start")
    strategy=strategy
    host=$root
    overlay=$menu/>

<span/$root
    ...htmlInput
    class=["menu-button", inputClass]
    onKeyDown(e, el) {
        if (open && e.key === "Escape") open = false;
        onKeyDown && onKeyDown(e, el);
    }
    onFocusOut(e, el) {
        if (!el.contains(e.relatedTarget as Node)) {
            open = false;
        }
        onFocusOut && onFocusOut(e, el);
    }>
    <${tagName as any}
        class=[`menu-button__button`]
        size=size
        priority=priority as ButtonInput["priority"]
        borderless=borderless
        variant=variant as any
        aria-haspopup="true"
        selected=isSelected
        transparent=transparent
        aria-expanded=expander.ariaExpanded
        aria-labelledby=prefixId && (variant === "icon" ? prefixId : `${prefixId} ${labelId}`)
        split=split
        disabled=disabled
        partiallyDisabled=partiallyDisabled
        onClick() { open = !open; }>
        <if=label>
            <span ...label class=["menu-button-prefix-label", label.class]/>
            ${" "}
        </if>
        <if=(variant === "icon")>
            <${input.content}/>
        </if>
        <else>
            <span id=prefixId && labelId>
                <${input.content}/>
            </span>
            <if=!noToggleIcon>
                <evo-icon-chevron-down-12/>
            </if>
        </else>
    </>
    <evo-menu/$menu:(() => HTMLSpanElement)
        style=expander.floatingStyles
        selected:=input.selected
        classPrefix="menu-button"
        fixed=strategy === "fixed"
        variant=(variant as MenuInput<Index>["variant"])
        fixWidth=fixWidth
        tabindex=-1
        footerButton=footerButton
        onClick() {
            if (collapseOnSelect) open = false;
        }
        item=items/>
</span>
