import type { Input as ExpanderInput } from "<evo-expander>";
export interface Input extends Marko.HTML.Span {
    /**
     * Visibility of the tourtip.
     * @default true
     */
    open?: boolean;
    openChange?: (open: boolean) => void;
    /**
     * Position of the overlay relative to the host element
     * @default "top"
     */
    placement?: ExpanderInput["placement"];
    /**
     * Offset distance from the host element in pixels
     * @default 6
     */
    offset?: number;
    /**
     * Enable automatic flipping when near viewport edge
     * @default true
     */
    flip?: boolean;
    /**
     * Enable automatic shifting when near viewport edge
     * @default false
     */
    shift?: boolean;
    /**
     * Enable inline positioning middleware
     * @default true
     */
    inline?: boolean;
    /** The host element that triggers the tourtip. */
    host: Marko.AttrTag<
        Marko.HTML.Span & {
            /**
             * Override the element that the item is rendered as, instead of `<span>`
             * @default "span"
             */
            as?: Marko.Renderable;
        }
    >;
    /** Optional heading content, rendered as an `<h2>` by default. */
    heading?: Marko.AttrTag<
        Marko.HTML.H2 & {
            /**
             * Override the element that the item is rendered as, instead of `<h2>`
             * @default "h2"
             */
            as?: Marko.Renderable;
        }
    >;
    /** Optional footer content, rendered as a styled `<span>`. */
    footer?: Marko.AttrTag<
        Marko.HTML.Span & {
            /** Text for pagination display */
            index?: string;
        }
    >;
    /**
     * The `aria-label` for the close button
     *
     * English default to be overridden is `"Dismiss tourtip"`
     * @default "Dismiss tourtip"
     */
    a11yCloseText: string;
}

<const/{
    class: inputClass,
    open: inputOpen = true,
    openChange,
    placement = "top" as const,
    offset = 6,
    flip,
    shift = false,
    inline,
    host,
    heading,
    footer,
    a11yCloseText = "Dismiss tourtip",
    ...htmlInput
}=input>

<let/open=(input.open ?? true) valueChange=openChange>

<id/hostId>

// remove once Marko supports dynamic tag vars
<id/headingId=heading?.id as string>
<id/overlayId>
<id/arrowId>

<evo-expander/expander
    open=open
    placement=placement
    offset=offset
    flip=flip
    shift=shift
    inline=inline
    strategy="absolute"
    host=() => (document.getElementById(hostId)!)
    overlay=() => (document.getElementById(overlayId)!)
    arrow=() => (document.getElementById(arrowId)!)/>

<span ...htmlInput class=["tourtip", open && "tourtip--expanded", inputClass]>
    <const/{ as: hostAs, class: hostClass, ...htmlHost }=host>
    <${hostAs ?? "span"}
        ...htmlHost
        id=hostId
        class=["tourtip__host", hostClass]/>
    <span
        class="tourtip__overlay"
        id=overlayId
        style=expander.floatingStyles
        role="region"
        aria-labelledby=heading && headingId>
        <span class="tourtip__pointer" id=arrowId style=expander.arrowStyles/>
        <span class="tourtip__mask">
            <span class="tourtip__cell">
                <span class="tourtip__content">
                    <if=heading>
                        <const/{
                            as: headingAs = "h2",
                            class: headingClass,
                            content: headingContent,
                            ...headingInput
                        }=heading>
                        <${headingAs}
                            ...headingInput
                            class=["tourtip__heading", headingClass]
                            id=headingId>
                            <${headingContent}/>
                        </>
                    </if>
                    <${input.content}/>
                </span>
                <button
                    aria-label=a11yCloseText
                    class="icon-btn icon-btn--transparent tourtip__close"
                    type="button"
                    onClick() {
                        open = false;
                    }>
                    <evo-icon-close-16/>
                </button>
                <if=footer>
                    <const/{
                        index,
                        class: footerClass,
                        content: footerContent,
                        ...htmlFooter
                    }=footer>
                    <span ...htmlFooter class=["tourtip__footer", footerClass]>
                        <if=index>
                            <span class="tourtip__index">
                                ${index}
                            </span>
                        </if>
                        <${footerContent}/>
                    </span>
                </if>
            </span>
        </span>
    </span>
</span>
