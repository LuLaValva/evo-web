import type { Input as ToggleButtonInput } from "../evo-toggle-button/index.marko";

export interface Input<
  Pressed extends
      | number
      | string
      | (number|string)[]
      | undefined
> extends Marko.HTML.Div {
    /** Represents a toggle button to be used as part of the group */
    button?: Marko.AttrTag<
        Omit<ToggleButtonInput, "pressed" | "pressedChange"> & {
            /** Used instead of `id` to check for equality with `pressed` with more consistency. */
            name?: string | number;
        }
    >;
    /** Values that are currently selected. Use a string or number for single select, or an array for multiselect */
    pressed?: Pressed;
    pressedChange?: (pressed: Pressed) => void;
    /** At least one button must be pressed at all times */
    required?: boolean;
    /** Localized, accessibility text for the group. Cannot be used together with `a11yLabelId` */
    a11yText?: string;
    /** Id of the element that labels the group. Required for a11y compliance. Cannot be used together with `a11yText` */
    a11yLabelId?: string;
    /** Preferred minimum number of columns for smallest container/screen (1-3). If this is not set will do an automatic layout. It is recommended to not set this unless needed. */
    columnsMin?: number;
    /** Preferred minimum number of columns within extra small containers. If this is not set will do an automatic layout. It is recommended to not set this unless needed. */
    columnsXS?: number;
    /** Preferred minimum number of columns within small containers. If this is not set will do an automatic layout. It is recommended to not set this unless needed. */
    columnsSM?: number;
    /** Preferred minimum number of columns within medium containers. If this is not set will do an automatic layout. It is recommended to not set this unless needed. */
    columnsMD?: number;
    /** Preferred minimum number of columns within extra large containers. If this is not set will do an automatic layout. It is recommended to not set this unless needed. */
    columnsXL?: number;
    /** Enforced layout type of all buttons. Gallery layout may only be used when there is also an icon or an image, and minimal layout may **not** be used when there is an icon or an image */
    layoutType?: ToggleButtonInput["layoutType"];
};
<const/{
    class: inputClass,
    layoutType: baseLayoutType,
    columnsMin,
    columnsXS,
    columnsSM,
    columnsMD,
    columnsXL,
    a11yText,
    a11yLabelId,
    required,
    pressed: inputPressed,
    button: buttons,
    ...htmlInput
}=input>
<let/pressed:=input.pressed>
<div
    class=["toggle-button-group", inputClass]
    data-columns-min=columnsMin
    data-columns-xs=columnsXS
    data-columns-sm=columnsSM
    data-columns-md=columnsMD
    data-columns-xl=columnsXL
    ...htmlInput>
    <ul aria-label=a11yText aria-labelledby=a11yLabelId>
        <for|button, i| of=buttons>
            <const/{
                layoutType = baseLayoutType,
                name = i,
                ...toggleButtonInput
            }=button>
            <li>
                <evo-toggle-button
                    layoutType=layoutType
                    ...toggleButtonInput
                    pressed=(
                       Array.isArray(pressed)
                            ? pressed.includes(name)
                            : pressed === name
                    )
                    pressedChange(p) {
                        if (Array.isArray(pressed)) {
                            // This is a "checkbox" type
                            if (!p) {
                                pressed = pressed.filter((n) => n !== name) as Pressed;
                            } else if (!pressed.includes(name) ){
                                pressed = [...pressed, name] as Pressed;
                            }
                        } else if (p) {
                            pressed = name as Pressed;
                        } else if (!required) {
                            pressed = undefined as Pressed;
                        }
                    }
                    />
            </li>
        </for>
    </ul>
</div>
