export interface Input extends Omit<Marko.HTML.Span, "title"> {
    /**
     * The layout of the card. The horizontal option takes up more horizontal space and is better for displaying more information.
     * @default "vertical"
     */
    layout?: "horizontal" | "vertical";
    /** The aspect ratio applied to the image. */
    aspectRatio?: "16:9" | "5:4";
    /** The overline element of the card. Generally used for signals rendered above the title. */
    overline?: Marko.AttrTag<Marko.HTML.Div>;
    /** The title element of the card, `<h3>` by default */
    title?: Marko.AttrTag<
        Marko.HTML.H3 & {
            /**
             * Overrides the tag used to wrap the title
             * @default "h3"
             */
            as?: keyof Marko.NativeTags;
        }
    >;
    /** The description element of the card. This is to render a description below the title in a tertiary element. */
    description?: Marko.AttrTag<Marko.HTML.Div>;
    /** Disables the interactive elements of the card. */
    disabled?: boolean;
    /** The action element of the card. When present, the whole card is no longer clickable. Should contain an interactive element. */
    action?: Marko.AttrTag<Marko.HTML.Div>;
    /** The URL to navigate to when the card is clicked. This can only be used _without_ an action element */
    href?: string;
    /** The top image tag. Will be passed as attributes to the `<img>` tag. */
    image: Marko.AttrTag<Marko.HTML.Img>;
}

<const/{
    class: inputClass,
    layout,
    href,
    aspectRatio,
    image,
    overline,
    title,
    disabled,
    description,
    action,
    ...htmlInput
}=input>

<define/Root|input: (Marko.HTML.Span | Marko.HTML.A | Marko.HTML.Button)|>
    <if=action>
        <span ...(input as Marko.HTML.Span)/>
    </if>
    <else if=href>
        <a ...(input as Marko.HTML.A) href=disabled ? "" : href/>
    </else>
    <else>
        <button ...(input as Marko.HTML.Button) type="button" disabled=disabled/>
    </else>
</define>

<Root ...htmlInput class=[
    "card",
    aspectRatio === "5:4" && "card--aspect-5-4",
    aspectRatio === "16:9" && "card--aspect-16-9",
    layout === "horizontal" && "card--horizontal",
    inputClass,
]>
    <div class="card__media">
        <img ...image>
    </div>
    <div class="card__main">
        <if=overline>
            <div ...overline class=["card__overline", overline.class]/>
        </if>
        <if=title>
            <const/{ as: elName = "h3", ...titleInput }=title>
            <${elName} ...titleInput class=["card__title", title.class]/>
        </if>
        <if=description>
            <div ...description class=["card__description", description.class]/>
        </if>
        <if=action>
            <div ...action class=["card__action", action.class]/>
        </if>
    </div>
</>
