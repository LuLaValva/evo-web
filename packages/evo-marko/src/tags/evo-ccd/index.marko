export interface Input extends Omit<Marko.HTML.Div, "aria-label"> {
    /** The maximum range. If min and max are both not set, then will not show the charger label. */
    max?: string;
    /** The minimum range. If min and max are both not set, then will not show the charger label. */
    min?: string;
    /** Toggles the charger icon visible or if it's included or not */
    chargerIcon?: "included" | "not-included";
    /**
     * The `aria-label` accessibility label for the ccd component.
     * It should use `min`, `max`, and charger included or not included, and secondaryText in the label in order to demonstrate
     * to screen readers the content on the component.
     *
     * Expected english value is `"Charger included. ${min} - ${max} Watts. USB PD"`
     * 
     * Pass `null` explicitly _only_ if alternative accessibility information is present
     */
    a11yText: string | null;
    /** Toggles the usbpd secondary text */
    secondaryType?: "usbpd";
    /**
     * The unit label displayed beneath the power range.
     * @default "W"
     */
    units?: string;
}
<const/{
    class: inputClass,
    a11yText,
    chargerIcon,
    max,
    min,
    secondaryType,
    units="W",
    ...htmlInput
}=input/>

<div
    ...htmlInput
    aria-label=a11yText
    role="img"
    class=["ccd", inputClass]
>
    <if=chargerIcon === "included">
        <evo-icon-ccd-charger-included class="ccd__charger-icon"/>
    </if>
    <else if=chargerIcon === "not-included">
        <evo-icon-ccd-charger-not-included class="ccd__charger-icon"/>
    </else>
    <if=min || max>
        <div class="ccd__description-figure">
            <evo-icon-ccd-top class="ccd__top-icon"/>
            <div class="ccd__body">
                <div>${min} - ${max}</div>
                <div>${units}</div>
                <if=secondaryType === "usbpd">
                    <div>USB PD</div>
                </if>
            </div>
        </div>
    </if>
</div>
