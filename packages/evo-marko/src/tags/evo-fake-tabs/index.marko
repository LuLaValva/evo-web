export interface Input extends Marko.HTML.Div {
    /**
     * Zero-based index of selected tab and panel
     * @default 0
     */
    selected?: number;
    size?: "large" | "regular";
    /** The tab element. This takes the same attributes as an anchor tag which navigates the user to a new page. */
    tab?: Marko.AttrTag<Marko.HTML.A>;
    /**
     * Specify whether the href of the currently active fake tab matches the current window url. This property is used to configure the underlying `aria-current` attribute (i.e. a value of `"page"` (default) or `"true"`).
     * @default true
     */
    tabMatchesCurrentUrl?: boolean;
}
<const/{
    selected = 0,
    class: inputClass,
    size = "regular",
    tab: tabs,
    tabMatchesCurrentUrl,
    content,
    ...htmlInput
}=input>

<const/tabAriaCurrent=(
    (tabMatchesCurrentUrl === false
        ? "true"
        : "page") as Marko.HTML.LI["aria-current"]
)>

<div ...htmlInput class=["fake-tabs", size === "large" && "fake-tabs--large", inputClass]>
    <ul class="fake-tabs__items">
        <for|tab, i| of=tabs || []>
            <const/{ href, class: tabClass, ...htmlTab }=tab>
            <li class=[tabClass, "fake-tabs__item"]>
                <a
                    ...htmlTab
                    aria-current=selected === i && tabAriaCurrent/>
            </li>
        </for>
    </ul>
    <div class="fake-tabs__content">
        <div class="fake-tabs__panel">
            <div class="fake-tabs__cell">
                <div>
                    <${content}/>
                </div>
            </div>
        </div>
    </div>
</div>
