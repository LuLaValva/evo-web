export interface Input extends Marko.HTML.Input {
    /**
     * If `large`, renders larger sized input.
     * @default "regular"
     */
    inputSize?: "regular" | "large";
    /** Input fills 100% of its container width. */
    fluid?: boolean;
    /** If set then shows this text as the floating label. */
    floatingLabel?: string;
    /** Floating label will _always_ stay in the "up" position */
    floatingLabelStatic?: boolean;
    /** An `<evo-icon-*>` to show before the input. Cannot be used with `floatingLabel`. */
    prefixIcon?: Marko.AttrTag<{ content: Marko.Body }>;
    /** Text to show before the input. */
    prefixText?: Marko.AttrTag<Marko.HTML.Span>;
    /** Text to show after the input. */
    postfixText?: Marko.AttrTag<Marko.HTML.Span>;
    /** An `<evo-icon-*>` to show after the input. Cannot be used with `floatingLabel`. */
    postfixIcon?: Marko.AttrTag<
        Marko.HTML.Button & {
            /** A descriptive label for the postfix icon button. If set, the icon becomes clickable and wrapped with a `<button>` tag. */
            a11yText?: string;
        }
    >;
    /** Indicates a field-level error with red border */
    invalid?: boolean;
}

<const/{
    class: inputClass,
    disabled,
    floatingLabel,
    floatingLabelStatic,
    fluid,
    id,
    inputSize,
    invalid,
    postfixIcon,
    prefixIcon,
    style,
    placeholder,
    prefixText,
    postfixText,
    readonly,
    onBlur,
    onFocus,
    ...htmlInput
}=input>

<id/prefixId>
<id/postfixId>
<id/inputId=id>
<let/focused=false>
<let/value:=input.value>

<evo-floating-label|{ showPlaceholder }|
    floatingLabel=floatingLabel
    size=inputSize
    alwaysUp=floatingLabelStatic
    htmlFor=inputId
    disabled=disabled
    invalid=invalid
    fluid=fluid
    value=value
    focused=focused>
    <${fluid ? "div" : "span"}
        style=style
        class=[
            "textbox" /** start remove after `:has` support */,
            disabled && "textbox--disabled",
            invalid && "textbox--invalid",
            readonly &&
                "textbox--readonly" /** end remove after `:has` support */,
            inputSize === "large" && "textbox--large",
            fluid && "textbox--fluid",
            inputClass,
        ]>
        <if=prefixIcon>
            <${prefixIcon}/>
        </if>
        <if=prefixText>
            <span ...prefixText id=prefixId/>
        </if>
        <input
            ...htmlInput
            aria-describedby=(
                [prefixText && prefixId, postfixText && postfixId]
                    .filter(Boolean)
                    .join(" ") || undefined
            )
            onBlur(e, target) {
                focused = false;
                onBlur && onBlur(e, target);
            }
            onFocus(e, target) {
                focused = true;
                (onFocus || null)?.(e, target);
            }
            id=inputId
            class="textbox__control"
            placeholder=showPlaceholder && placeholder
            value:=value
            disabled=disabled
            aria-invalid=invalid && "true"
            readonly=readonly>
        <if=postfixText>
            <span ...postfixText id=postfixId/>
        </if>
        <if=postfixIcon>
            <const/{ a11yText, ...postfixIconInput }=postfixIcon>
            <${a11yText && "button"}
                ...postfixIconInput
                aria-label=a11yText
                class=[
                    "icon-btn",
                    "icon-btn--transparent",
                    postfixIcon.class,
                ]
                type="button"
                disabled=disabled>
                <${postfixIcon}/>
            </>
        </if>
    </>
</evo-floating-label>
