export interface Input extends Marko.Input<"details"> {
    /** The body which will be wrapped as the details summary */
    summary?: Marko.AttrTag<Marko.Input<"span">>;
    /** Optional leading element (e.g. an icon) rendered before the summary label */
    leading?: Marko.AttrTag<Marko.Input<"span">>;
    /**
     * Size of the details
     * @default "regular"
     */
    size?: "regular" | "small";
    /**
     * The position of the details
     * @default "regular"
     */
    alignment?: "regular" | "center";
    /**
     * The root element inside the `<details>` that wraps content.
     * @default "div"
     */
    contentAs?: keyof Marko.NativeTags;
    /** Whether details is open */
    open?: boolean;
    openChange?: (open: boolean) => void;
}

<const/{
    class: inputClass,
    alignment,
    size,
    summary,
    leading,
    content,
    contentAs,
    ...htmlInput
}=input>

<details ...htmlInput class=["details", inputClass]>
    <if=summary>
        <summary class=[
            "details__summary",
            size === "small" && "details__summary--small",
            alignment === "center" && "details__summary--center",
        ]>
            <if=leading>
                <span ...leading class=["details__leading", leading.class]/>
            </if>
            <span ...summary class=["details__label", summary.class]/>
            <span class="details__icon" hidden>
                <evo-icon-chevron-down-16/>
            </span>
        </summary>
    </if>
    <${contentAs || "div"} class="details__content">
        <${content}/>
    </>
</details>
